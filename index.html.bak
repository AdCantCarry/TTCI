            <!-- 2. Trụ sở & Hòm thư -->
            <div class="ofc-box">
              <div class="ofc-box-icon address">📍</div>
              <div>
                <div class="ofc-box-label">Trụ sở làm việc & Hòm thư</div>
                <div style="font-weight:700; color:#1B2A4A; line-height:1.35; margin-top:2px;">116 Phan Văn Hớn, P. Đông
                  Hưng Thuận, TP. Hồ Chí Minh</div>
                <div style="margin-top:2px;">
                  <a href="mailto:ttdvcphuongdonghungthuan@gmail.com"
                    style="color:#1D5FD8; text-decoration:none; font-size:12.5px; font-weight:500;">✉️
                    ttdvcphuongdonghungthuan@gmail.com</a>
                </div>
