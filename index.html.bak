hân thân/pháp nhân (3): " }, { "f": "w3", "w": 21 }] } }, { "p": { "runs": [{ "s": "c) Địa chỉ (4): " }, { "f": "w4", "w": 31 }] } }, { "p": { "runs": [{ "s": "d) Điện thoại liên hệ (nếu có): " }, { "f": "w5", "w": 5 }, { "s": ", Hộp thư điện tử (nếu có): " }, { "f": "w6", "w": 7 }] } }, { "p": { "runs": [{ "s": "2. Thửa đất đăng ký " }, { "s": "(người sử dụng đất là tổ chức thì không phải kê khai mục này)", "i": 1 }, { "s": ":" }] } }, { "p": { "runs": [{ "s": " (Trường hợp đăng ký nhiều thửa đất nông nghiệp mà không đề nghị cấp Giấy chứng nhận hoặc đề nghị cấp chung một Giấy chứng nhận cho nhiều thửa đất nông nghiệp thì không kê khai các nội dung tại Mục này mà chỉ ghi tổng số thửa và kê khai từng thửa đất theo Mẫu số 15b)", "i": 1 }] } }, { "p": { "runs": [{ "s": "a) Thửa đất số (4a): " }, { "f": "w7", "w": 8 }, { "s": "; Tờ bản đồ số (4b): " }, { "f": "w8", "w": 13 }] } }, { "p": { "runs": [{ "s": "b) Địa chỉ (5): " }, { "f": "w9", "w": 31 }] } }, { "p": { "runs": [{ "s": "c) Diện tích (6): " }, { "f": "w10", "w": 4 }, { "s": " m²; sử dụng chung: " }, { "f": "w11", "w": 3 }, { "s": " m²; sử dụng riêng: " }, { "f": "w12", "w": 4 }, { "s": " m²." }] } }, { "p": { "runs": [{ "s": "d) Sử dụng vào mục đích (7): " }, { "f": "w13", "w": 6 }, { "s": ", từ thời điểm: " }, { "f": "w14", "w": 12 }] } }, { "p": { "runs": [{ "s": "đ) Thời hạn đề nghị được sử dụng đất (8): " }, { "f": "w15", "w": 21 }] } }, { "p": { "runs": [{ "s": "e) Nguồn gốc sử dụng đất (9): " }, { "f": "w16", "w": 24 }] } }, { "p": { "runs": [{ "s": "g) Có quyền hoặc hạn chế quyền đối với thửa đất liền kề số " }, { "f": "w17", "w": 2 }, { "s": ", tờ bản đồ số " }, { "f": "w18", "w": 4 }, { "s": ", của " }, { "f": "w19", "w": 4 }, { "s": ", nội dung về quyền đối với thửa đất liền kề " }, { "f": "w20", "w": 11 }, { "s": " (10)." }] } }, { "p": { "runs": [{ "s": "3. Nhà ở, công trình xây dựng " }, { "s": "(người sử dụng đất là tổ chức thì không phải kê khai mục này)", "i": 1 }, { "s": ":" }] } }, { "p": { "runs": [{ "s": " (Chỉ kê khai nếu có nhu cầu đăng ký hoặc chứng nhận quyền sở hữu tài sản; Trường hợp có nhiều nhà ở, công trình xây dựng khác trên cùng 01 thửa đất thì chỉ kê khai các thông tin chung và tổng diện tích của các nhà ở, công trình xây dựng; đồng thời lập danh sách nhà ở, công trình theo Mẫu số 15c)", "i": 1 }] } }, { "p": { "runs": [{ "s": "a) Loại nhà ở, công trình xây dựng (11): " }, { "f": "w21", "w": 21 }] } }, { "p": { "runs": [{ "s": "b) Diện tích xây dựng (12): " }, { "f": "w22", "w": 13 }, { "s": " m²." }] } }, { "p": { "runs": [{ "s": "c) Diện tích sàn xây dựng/diện tích sử dụng (13): " }, { "f": "w23", "w": 4 }, { "s": " m²." }] } }, { "p": { "runs": [{ "s": "d) Sở hữu chung (14): " }, { "f": "w24", "w": 6 }, { "s": " m², sở hữu riêng (14): " }, { "f": "w25", "w": 7 }, { "s": " m²." }] } }, { "p": { "runs": [{ "s": "đ) Số tầng: " }, { "f": "w26", "w": 2 }, { "s": " tầng; trong đó, số tầng nổi: " }, { "f": "w27", "w": 2 }, { "s": " tầng, số tầng hầm: " }, { "f": "w28", "w": 2 }, { "s": " tầng." }] } }, { "p": { "runs": [{ "s": "e) Nguồn gốc (15): " }, { "f": "w29", "w": 30 }] } }, { "p": { "runs": [{ "s": "g) Năm hoàn thành xây dựng (16): " }, { "f": "w30", "w": 24 }] } }, { "p": { "runs": [{ "s": "h) Thời hạn sở hữu đến (17): " }, { "f": "w31", "w": 24 }] } }, { "p": { "runs": [{ "s": "i) Cam kết về việc đủ điều kiện tồn tại nhà ở, công trình xây dựng (18): " }, { "cb": "camKet", "o": "X" }] } }, { "p": { "runs": [{ "s": "4. Đề nghị của người sử dụng đất, chủ sở hữu tài sản gắn liền với đất:" }] } }, { "p": { "runs": [{ "s": "(Đánh dấu ", "i": 1 }, { "s": " " }, { "s": "vào ô lựa chọn)", "i": 1 }] } }, { "p": { "runs": [{ "s": "a) Đề nghị đăng ký đất đai, tài sản gắn liền với đất " }, { "cb": "w32", "o": "tài sản gắn liền với đất" }] } }, { "p": { "runs": [{ "s": "b) Đề nghị cấp Giấy chứng nhận " }, { "cb": "w33", "o": "nghị cấp Giấy chứng nhận" }] } }, { "p": { "runs": [{ "s": "c) Đề nghị ghi nợ tiền sử dụng đất " }, { "s": "(đối với cá nhân) ", "i": 1 }, { "cb": "w34", "o": "ụng đất (đối với cá nhân)" }] } }, { "p": { "runs": [{ "s": "d) Đề nghị khác (nếu có): " }, { "f": "w35", "w": 27 }] } }, { "p": { "runs": [{ "s": "5. Thông tin về đối tượng được miễn, giảm nghĩa vụ tài chính về đất đai (nếu có)(19):" }] } }, { "p": { "runs": [{ "f": "w36", "w": 37 }] } }, { "p": { "runs": [{ "s": "6. Những giấy tờ nộp kèm theo (20):" }] } }, { "p": { "runs": [{ "s": "(1) " }, { "f": "w37", "w": 35 }] } }, { "p": { "runs": [{ "s": "(2) " }, { "f": "w38", "w": 35 }] } }, { "p": { "runs": [{ "s": "(3) " }, { "f": "w39", "w": 35 }] } }, { "p": { "runs": [{ "s": "Tôi/chúng tôi xin cam đoan nội dung kê khai trên đơn là đúng sự thật, nếu sai tôi/chúng tôi hoàn toàn chịu trách nhiệm trước pháp luật." }] } }, { "p": { "runs": [{ "s": " " }] } }, { "tb": [[[{ "p": { "runs": [{ "s": " " }] } }], [{ "p": { "runs": [{ "f": "w40", "w": 2 }, { "s": ", ngày ", "i": 1 }, { "f": "w41", "w": 2 }, { "s": " " }, { "s": "tháng ", "i": 1 }, { "f": "w42", "w": 2 }, { "s": " " }, { "s": "năm ", "i": 1 }, { "f": "w43", "w": 2 }, { "s": "\n" }, { "s": "Người sử dụng đất/Người kê khai", "b": 1 }, { "s": "\n" }, { "s": "Ký, ghi rõ họ tên hoặc đóng dấu (nếu có)", "i": 1 }], "al": "center" } }]]] }, { "p": { "runs": [{ "s": " " }] } }, { "p": { "runs": [{ "s": "Hướng dẫn kê khai đơn: ", "b": 1 }, { "s": "Lưu ý: xem kỹ hướng dẫn viết Đơn trước khi kê khai; không tẩy xóa, sửa chữa trên Đơn.", "i": 1 }] } }, { "p": { "runs": [{ "s": "(1) Đối với hộ gia đình, cá nhân, cộng đồng dân cư, người gốc Việt Nam định cư nước ngoài thì ghi: “Ủy ban nhân dân xã/phường/đặc khu " }, { "s": "..." }, { "s": "”; đối với tổ chức thì ghi: “Sở Nông nghiệp và Môi trường " }, { "s": "..." }, { "s": "” ." }] } }, { "p": { "runs": [{ "s": "(2) Cá nhân: Ghi họ và tên bằng chữ in hoa, năm sinh theo giấy tờ nhân thân. Người gốc Việt Nam định cư ở nước ngoài: Ghi họ tên, năm sinh, quốc tịch. Cộng đồng dân cư: Ghi tên của cộng đồng dân cư. Tổ chức: Ghi theo quyết định thành lập hoặc giấy đăng ký kinh doanh." }] } }, { "p": { "runs": [{ "s": "(3) Cá nhân: Ghi số định danh cá nhân hoặc số, ngày cấp và nơi cấp hộ chiếu." }] } }, { "p": { "runs": [{ "s": "Tổ chức: Ghi số, ngày ký, cơ quan ký văn bản theo quyết định thành lập hoặc giấy đăng ký kinh doanh." }] } }, { "p": { "runs": [{ "s": "(4) Cá nhân: Ghi địa chỉ nơi đăng ký thường trú. Người gốc Việt Nam định cư ở nước ngoài:" }] } }, { "p": { "runs": [{ "s": "Ghi địa chỉ đăng ký thường trú ở Việt Nam (nếu có). Cộng đồng dân cư: Ghi địa chỉ nơi sinh hoạt chung của cộng đồng." }] } }, { "p": { "runs": [{ "s": "Tổ chức: Ghi địa chỉ trụ sở chính theo quyết định thành lập hoặc giấy đăng ký kinh doanh." }] } }, { "p": { "runs": [{ "s": "(5) Ghi số nhà, tên đường, phố (nếu có); tên điểm dân cư (tổ dân phố, thôn, xóm, làng, ấp, bản, bon, buôn, phum, sóc, điểm dân cư tương tự) hoặc tên khu vực, xứ đồng (đối với thửa đất ngoài khu dân cư); tên đơn vị hành chính các cấp xã, tỉnh nơi có thửa đất." }] } }, { "p": { "runs": [{ "s": "(6) Ghi diện tích của thửa đất bằng số Ả Rập, được làm tròn số đến một chữ số thập phân." }] } }, { "p": { "runs": [{ "s": "(7) Ghi mục đích chính đang sử dụng. Từ thời điểm ghi ngày " }, { "s": "..." }, { "s": " tháng " }, { "s": "..." }, { "s": " năm " }, { "s": "..." }] } }, { "p": { "runs": [{ "s": "(8) Ghi “đến ngày " }, { "s": "..." }, { "s": "/" }, { "s": "..." }, { "s": "/" }, { "s": "..." }, { "s": "” hoặc “Lâu dài” hoặc ghi bằng dấu “-/-” nếu không xác định được thời hạn." }] } }, { "p": { "runs": [{ "s": "(9) Ghi được Nhà nước giao đất có thu tiền sử dụng đất hoặc giao đất không thu tiền sử dụng đất hoặc cho thuê đất trả tiền một lần cho cả thời gian thuê hoặc cho thuê đất trả tiền thuê đất hằng năm hoặc nhận chuyển quyền (chuyển đổi, chuyển nhượng, thừa kế, tặng cho, góp vốn) hoặc nguồn gốc khác như do ông cha để lại, lấn, chiếm, giao đất không đúng thẩm quyền, khai hoang" }, { "s": "..." }] } }, { "p": { "runs": [{ "s": "(10) Ghi theo văn bản xác lập quyền được sử dụng." }] } }, { "p": { "runs": [{ "s": "(11) Ghi Nhà ở riêng lẻ/căn hộ chung cư/văn phòng/nhà xưởng" }, { "s": "..." }] } }, { "p": { "runs": [{ "s": "(12) Đối với nhà ở riêng lẻ, công trình xây dựng độc lập ghi diện tích mặt bằng chiếm đất của nhà ở, công trình tại vị trí tiếp xúc với mặt đất theo mép ngoài tường bao của nhà ở, công trình được làm tròn số đến một chữ số thập phân." }] } }, { "p": { "runs": [{ "s": "Đối với căn hộ chung cư, văn phòng, hạng mục công trình thuộc tòa nhà chung cư, tòa nhà hỗn hợp thì ghi diện tích sàn/diện tích sử dụng căn hộ chung cư, văn phòng, hạng mục công trình đó." }] } }, { "p": { "runs": [{ "s": "(13) Đối với nhà ở, công trình một tầng thì không ghi nội dung này. Đối với nhà ở, công trình nhiều tầng thì ghi tổng diện tích mặt bằng sàn xây dựng của các tầng." }] } }, { "p": { "runs": [{ "s": "(14) Diện tích “Sở hữu chung” là phần diện tích thuộc quyền sở hữu của nhiều người; Diện tích “Sở hữu riêng” là phần diện tích thuộc quyền sở hữu của một người (một cá nhân, một cộng đồng dân cư)." }] } }, { "p": { "runs": [{ "s": "(15) Ghi tự đầu tư xây dựng, mua, được tặng cho " }, { "s": "..." }] } }, { "p": { "runs": [{ "s": "(16) Chủ sở hữu tài sản tự xác định và chịu trách nhiệm đối với nội dung kê khai." }] } }, { "p": { "runs": [{ "s": "(17) Ghi “đến ngày " }, { "s": "..." }, { "s": "/" }, { "s": "..." }, { "s": "/" }, { "s": "..." }, { "s": "” hoặc ghi bằng dấu “-/-” nếu không xác định được thời hạn." }] } }, { "p": { "runs": [{ "s": "(18) Trường hợp người sử dụng đất, chủ sở hữu tài sản gắn liền với đất đề nghị chứng nhận quyền sở hữu nhà ở, công trình xây dựng thuộc trường hợp phải xin phép xây dựng quy định tại khoản 3 Điều 148, khoản 3 Điều 149 của Luật Đất đai mà không có giấy xác nhận của cơ quan có thẩm quyền thì đánh dấu " }, { "cb": "w58", "o": "ó thẩm quyền thì đánh dấu" }, { "s": " vào ô lựa chọn." }] } }, { "p": { "runs": [{ "s": "(19) Người sử dụng đất, chủ sở hữu tài sản gắn liền với đất thuộc đối tượng được miễn, giảm nghĩa vụ tài chính về đất đai theo quy định pháp luật thì ghi rõ trường hợp thuộc diện được miễn, giảm (ví dụ: thương binh, đối tượng chính sách, " }, { "s": "..." }, { "s": ") vào mục này." }] } }, { "p": { "runs": [{ "s": "(20) Đối với tổ chức thì phải nộp kèm theo Báo cáo kết quả rà soát hiện trạng sử dụng đất của tổ chức theo Mẫu số 15d hoặc Báo cáo kết quả rà soát hiện trạng sử dụng đất của người được giao quản lý đất/người được quản lý đất Mẫu số 15đ, trừ trường hợp tổ chức nhận chuyển nhượng dự án đầu tư có sử dụng đất." }] } }, { "p": { "runs": [{ "s": "Trường hợp người sử dụng đất, chủ sở hữu tài sản gắn liền với đất thuộc đối tượng được miễn, giảm nghĩa vụ tài chính về đất đai theo quy định pháp luật thì nộp giấy tờ chứng minh là đối tượng được miễn, giảm theo quy định pháp luật về quản lý thuế." }] } }, { "p": { "runs": [] } }] }, { "id": "dd-dinh-chinh", "kind": "docx", "group": "Đất đai", "title": "Đơn đăng ký biến động / đính chính Giấy chứng nhận (Mẫu số 18)", "form": [{ "sec": "Cơ quan tiếp nhận" }, { "key": "coQuanNhan", "label": "Kính gửi", "wide": true, "default": "Văn phòng đăng ký đất đai TP. Hồ Chí Minh", "hint": "Hộ gia đình, cá nhân thì ghi Văn phòng/Chi nhánh Văn phòng đăng ký đất đai nơi có đất.", "to": ["w1"] }, { "sec": "Người sử dụng đất, chủ sở hữu tài sản" }, { "key": "hoTen", "label": "Họ và tên", "std": "hoTen", "upper": true, "wide": true, "hint": "Mẫu yêu cầu ghi chữ in hoa — khi in sẽ tự viết hoa.", "to": ["w2"] }, { "key": "giayToNhanThan", "label": "Giấy tờ nhân thân", "std": "cccd", "wide": true, "placeholder": "Số định danh cá nhân, hoặc số – ngày cấp – nơi cấp hộ chiếu", "to": ["w3"] }, { "key": "diaChi", "label": "Địa chỉ thường trú", "std": "noiThuongTru", "suggest": "diaChi", "wide": true, "to": ["w4"] }, { "key": "maSoThue", "label": "Mã số thuế (nếu có)", "to": ["w5"] }, { "key": "dienThoai", "label": "Điện thoại liên hệ", "std": "dienThoai", "to": ["w6"] }, { "key": "email", "label": "Hộp thư điện tử (nếu có)", "std": "email", "to": ["w7"] }, { "sec": "Nội dung biến động" }, { "key": "noiDung", "label": "Nội dung biến động đề nghị", "type": "textarea", "wide": true, "placeholder": "VD: Đề nghị đính chính sai sót về họ tên trên Giấy chứng nhận số ... do cơ quan ... cấp ngày .../.../...", "hint": "Ghi rõ đề nghị đính chính nội dung nào, trên Giấy chứng nhận số bao nhiêu.", "to": ["w8"] }, { "key": "noiDungThem", "label": "Nội dung bổ sung (nếu còn)", "type": "textarea", "wide": true, "to": ["w9"] }, { "sec": "Miễn, giảm nghĩa vụ tài chính", "optional": true, "note": "Chỉ khai nếu thuộc diện được miễn, giảm (thương binh, đối tượng chính sách…)." }, { "key": "mienGiam", "label": "Thuộc diện được miễn, giảm", "wide": true, "to": ["w10"] }, { "sec": "Giấy tờ nộp kèm", "optional": true, "note": "Giấy chứng nhận đã cấp là bắt buộc và đã in sẵn ở mục (1). Ghi thêm giấy tờ khác nếu có." }, { "key": "giayTo2", "label": "Giấy tờ (2)", "wide": true, "to": ["w11"] }, { "key": "giayTo3", "label": "Giấy tờ (3)", "wide": true, "to": ["w12"] }, { "sec": "Nơi và ngày lập" }, { "key": "noiLap", "label": "Làm tại (địa danh)", "default": "Đông Hưng Thuận", "std": "noiLapTK", "to": ["w13"] }, { "key": "ngayLap", "label": "Ngày lập đơn", "type": "date", "default": "today", "to": { "w14": "d", "w15": "m", "w16": "y" } }], "blocks": [{ "p": { "runs": [{ "s": "Mẫu số 18. Đơn đăng ký đất đai, tài sản gắn liền với đất", "b": 1 }] } }, { "p": { "runs": [{ "s": "CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM", "b": 1 }, { "s": "\n" }, { "s": "Độc lập - Tự do - Hạnh phúc", "b": 1 }, { "s": "\n" }, { "s": "---------------", "b": 1 }], "al": "center" } }, { "p": { "runs": [{ "s": "ĐƠN ĐĂNG KÝ ĐẤT ĐAI, TÀI SẢN GẮN LIỀN VỚI ĐẤT", "b": 1 }], "al": "center" } }, { "p": { "runs": [{ "s": "Kính gửi: " }, { "f": "w1", "w": 12 }, { "s": " (1)" }], "al": "center" } }, { "p": { "runs": [{ "s": "I. Người sử dụng đất, chủ sở hữu tài sản gắn liền với đất:" }] } }, { "p": { "runs": [{ "s": "- Họ và tên (2): " }, { "f": "w2", "w": 29 }] } }, { "p": { "runs": [{ "s": "- Giấy tờ nhân thân/pháp nhân (3): " }, { "f": "w3", "w": 23 }] } }, { "p": { "runs": [{ "s": "- Địa chỉ (4): " }, { "f": "w4", "w": 30 }] } }, { "p": { "runs": [{ "s": "- Mã số thuế (nếu có): " }, { "f": "w5", "w": 26 }] } }, { "p": { "runs": [{ "s": "- Điện thoại liên hệ (nếu có): " }, { "f": "w6", "w": 5 }, { "s": ", Hộp thư điện tử (nếu có): " }, { "f": "w7", "w": 8 }] } }, { "p": { "runs": [{ "s": " (Trường hợp có nhiều đồng sử dụng, sở hữu thì kê khai thông tin một người đại diện;", "i": 1 }, { "s": " " }, { "s": "đồng thời lập danh sách theo Bảng 18a đính kèm)", "i": 1 }] } }, { "p": { "runs": [{ "s": "II. Nội dung biến động(5):" }] } }, { "p": { "runs": [{ "f": "w8", "w": 37 }] } }, { "p": { "runs": [{ "f": "w9", "w": 37 }] } }, { "p": { "runs": [{ "s": "III. Thông tin về đối tượng được miễn, giảm nghĩa vụ tài chính về đất đai (nếu có)(6):" }] } }, { "p": { "runs": [{ "f": "w10", "w": 37 }] } }, { "p": { "runs": [{ "s": "IV. Giấy tờ liên quan đến nội dung biến động nộp kèm theo đơn này gồm có(7):" }] } }, { "p": { "runs": [{ "s": "(1) Giấy chứng nhận đã cấp;" }] } }, { "p": { "runs": [{ "s": "(2) " }, { "f": "w11", "w": 35 }] } }, { "p": { "runs": [{ "s": "(3) " }, { "f": "w12", "w": 35 }] } }, { "p": { "runs": [{ "s": "Cam đoan nội dung kê khai trên đơn là đúng sự thật và chịu trách nhiệm trước pháp luật." }] } }, { "p": { "runs": [{ "s": " " }] } }, { "tb": [[[{ "p": { "runs": [{ "s": " " }] } }], [{ "p": { "runs": [{ "f": "w13", "w": 2 }, { "s": ", ngày ", "i": 1 }, { "f": "w14", "w": 2 }, { "s": " " }, { "s": "tháng ", "i": 1 }, { "f": "w15", "w": 2 }, { "s": " " }, { "s": "năm ", "i": 1 }, { "f": "w16", "w": 2 }, { "s": "\n" }, { "s": "Người sử dụng đất/Người kê khai", "b": 1 }, { "s": "\n" }, { "s": "Ký, ghi rõ họ tên hoặc đóng dấu (nếu có)", "i": 1 }], "al": "center" } }]]] }, { "p": { "runs": [{ "s": " " }] } }, { "p": { "runs": [{ "s": "Hướng dẫn kê khai đơn:", "b": 1 }] } }, { "p": { "runs": [{ "s": "(1) ) Đối với hộ gia đình, cá nhân, cộng đồng dân cư, người gốc Việt Nam định cư ở nước ngoài thì ghi: “Văn phòng đăng ký đất đai/Chi nhánh Văn phòng đăng ký đất đai" }, { "s": "..." }, { "s": "” nơi có đất. Trường hợp cấp Giấy chứng nhận đối với thửa đất có phần diện tích tăng thêm mà thửa đất gốc đã được cấp Giấy chứng nhận, phần diện tích tăng thêm chưa được cấp Giấy chứng nhận/thửa đất có một phần diện tích chưa được cấp Giấy chứng nhận thì ghi: “Ủy ban nhân dân xã/phường/đặc khu " }, { "s": "..." }, { "s": "”." }] } }, { "p": { "runs": [{ "s": "Đối với tổ chức trong nước, tổ chức tôn giáo, tổ chức tôn giáo trực thuộc, tổ chức kinh tế có vốn đầu tư nước ngoài, tổ chức nước ngoài có chức năng ngoại giao và tổ chức nước ngoài, cá nhân nước ngoài thì ghi “Văn phòng đăng ký đất đai" }, { "s": "..." }, { "s": "” nơi có đất." }] } }, { "p": { "runs": [{ "s": "(2) Cá nhân: Ghi họ và tên bằng chữ in hoa, năm sinh theo giấy tờ nhân thân. Người gốc Việt Nam định cư ở nước ngoài: Ghi họ tên, năm sinh, quốc tịch. Cộng đồng dân cư: Ghi tên của cộng đồng dân cư. Tổ chức: Ghi theo quyết định thành lập hoặc giấy đăng ký kinh doanh." }] } }, { "p": { "runs": [{ "s": "Trường hợp nhận chuyển quyền sử dụng đất, quyền sở hữu tài sản gắn liền với đất thì ghi thông tin của bên nhận chuyển quyền." }] } }, { "p": { "runs": [{ "s": "(3) Cá nhân: Ghi số định danh cá nhân hoặc số, ngày cấp và nơi cấp hộ chiếu." }] } }, { "p": { "runs": [{ "s": "Tổ chức: Ghi số, ngày ký, cơ quan ký văn bản theo quyết định thành lập hoặc giấy đăng ký kinh doanh." }] } }, { "p": { "runs": [{ "s": "(4) Cá nhân: Ghi địa chỉ nơi đăng ký thường trú. Người gốc Việt Nam định cư ở nước ngoài: Ghi địa chỉ đăng ký thường trú ở Việt Nam (nếu có). Cộng đồng dân cư: Ghi địa chỉ nơi sinh hoạt chung của cộng đồng." }] } }, { "p": { "runs": [{ "s": "Tổ chức: Ghi địa chỉ trụ sở chính theo quyết định thành lập hoặc giấy đăng ký kinh doanh." }] } }, { "p": { "runs": [{ "s": "(5) Ghi nội dung biến động như: “nhận chuyển nhượng, nhận tặng cho " }, { "s": "..." }, { "s": ", cấp lại Giấy chứng nhận do bị mất, cấp đổi Giấy chứng nhận " }, { "s": "..." }, { "s": "”." }] } }, { "p": { "runs": [{ "s": "Trường hợp đề nghị cấp lại Giấy chứng nhận do bị mất thì ghi nội dung: “" }, { "s": "đề nghị cấp lại Giấy chứng nhận do bị mất", "i": 1 }, { "s": "” và thể hiện thông tin Giấy chứng nhận bị mất, gồm: số vào sổ cấp Giấy chứng nhận " }, { "s": "..." }, { "s": "; Số phát hành Giấy chứng nhận (Số seri) " }, { "s": "..." }, { "s": "”, trường hợp người sử dụng đất, chủ sở hữu tài sản gắn liền với đất không có thông tin về Giấy chứng nhận đã cấp thì không kê khai nội dung tại mục này. Cơ quan giải quyết thủ tục hành chính kiểm tra hồ sơ địa chính, cơ sở dữ liệu đất đai để xác định các thông tin tại mục này, trong đó thông tin bắt buộc phải có là thông tin số vào sổ cấp Giấy chứng nhận hoặc số phát hành Giấy chứng nhận (Số seri)." }] } }, { "p": { "runs": [{ "s": "Trường hợp có nhu cầu cấp mới Giấy chứng nhận thì ghi “" }, { "s": "có nhu cầu cấp mới Giấy chứng nhận", "i": 1 }, { "s": "”." }] } }, { "p": { "runs": [{ "s": "(6) Người sử dụng đất, chủ sở hữu tài sản gắn liền với đất thuộc đối tượng được miễn, giảm nghĩa vụ tài chính về đất đai theo quy định pháp luật thì ghi rõ trường hợp thuộc diện được miễn, giảm (ví dụ: thương binh, đối tượng chính sách, " }, { "s": "..." }, { "s": ") vào mục này." }] } }, { "p": { "runs": [{ "s": "(7) Ghi các loại giấy tờ nộp kèm theo Đơn này." }] } }, { "p": { "runs": [{ "s": "Trường hợp người sử dụng đất, chủ sở hữu tài sản gắn liền với đất thuộc đối tượng được miễn, giảm nghĩa vụ tài chính về đất đai theo quy định pháp luật thì nộp giấy tờ chứng minh là đối tượng được miễn, giảm theo quy định pháp luật về quản lý thuế." }] } }, { "p": { "runs": [{ "s": " " }] } }, { "p": { "runs": [{ "s": "Bảng 18a: Danh sách những người sử dụng đất, tài sản gắn liền với đất", "b": 1 }] } }, { "p": { "runs": [{ "s": "DANH SÁCH NHỮNG NGƯỜI SỬ DỤNG ĐẤT, TÀI SẢN GẮN LIỀN VỚI ĐẤT", "b": 1 }], "al": "center" } }, { "p": { "runs": [{ "s": "(Kèm theo Mẫu số 18)", "i": 1 }], "al": "center" } }, { "tb": [[[{ "p": { "runs": [{ "s": "Số", "b": 1 }, { "s": " " }, { "s": "thứ tự", "b": 1 }], "al": "center" } }], [{ "p": { "runs": [{ "s": "Tên người sử dụng đất, chủ sở hữu tài sản gắn liền với đất, người nhận chuyển quyền sử dụng đất, tài sản gắn liền với đất", "b": 1 }], "al": "center" } }], [{ "p": { "runs": [{ "s": "Địa chỉ", "b": 1 }], "al": "center" } }], [{ "p": { "runs": [{ "s": "Mã số thuế", "b": 1 }, { "s": " " }, { "s": "(nếu có)", "b": 1 }], "al": "center" } }], [{ "p": { "runs": [{ "s": "Giấy tờ pháp nhân/Số hộ chiếu/Số định danh cá nhân", "b": 1 }], "al": "center" } }], [{ "p": { "runs": [{ "s": "Diện tích sử dụng/Tỷ lệ sở hữu (nếu có)", "b": 1 }], "al": "center" } }], [{ "p": { "runs": [{ "s": "Ghi chú(*)", "b": 1 }], "al": "center" } }]], [[{ "p": { "runs": [{ "s": "1" }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }]], [[{ "p": { "runs": [{ "s": "2" }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }]], [[{ "p": { "runs": [{ "s": "3" }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }], "al": "center" } }], [{ "p": { "runs": [{ "s": " " }],