              <span class="vi">⚡</span>
              <div>
                <b>Nhanh chóng</b>
                <span>Tiết kiệm thời gian</span>
              </div>
            </div>
            <div class="ofc-val-item">
              <span class="vi">🛡️</span>
              <div>
                <b>An toàn</b>
                <span>Bảo mật thông tin</span>
              </div>
            </div>
            <div class="ofc-val-item">
              <span class="vi">🌟</span>
              <div>
                <b>Thuận tiện</b>
