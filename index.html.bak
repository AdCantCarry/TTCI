<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hệ thống Tờ khai Điện tử - Trung tâm Cung ứng Dịch vụ công phường Đông Hưng Thuận</title>
  <link rel="icon" type="image/png" href="./logo.png">
  <style>
    :root {
      --paper: #F6F7FB;
      --paper-2: #EDF0F9;
      --ink: #1B1E2B;
      --ink-soft: #4B5169;
      --muted: #7C8299;
      --line: #E1E4F0;
      --accent: #2F6FED;
      --accent-2: #00B39F;
      --accent-ink: #FFFFFF;
      --accent-soft: #E6EEFF;
      --good: #1F9D67;
      --card-bg: #FFFFFF;
      --shadow: 0 1px 2px rgba(24, 28, 47, .04), 0 10px 28px rgba(47, 111, 237, .09);
      --radius: 18px;
      --focus: #B25E00;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --paper: #12151F;
        --paper-2: #191D2C;
        --ink: #EDEFF8;
        --ink-soft: #C3C8DC;
        --muted: #8892AC;
        --line: #2B3049;
        --accent: #6C93FF;
        --accent-2: #38D0BE;
        --accent-ink: #0B0E17;
        --accent-soft: #1E2846;
        --good: #4ADE95;
        --card-bg: #191D2C;
        --shadow: 0 1px 2px rgba(0, 0, 0, .35), 0 10px 28px rgba(0, 0, 0, .4);
      }
    }

    :root[data-theme="dark"] {
      --paper: #12151F;
      --paper-2: #191D2C;
      --ink: #EDEFF8;
      --ink-soft: #C3C8DC;
      --muted: #8892AC;
      --line: #2B3049;
      --accent: #6C93FF;
      --accent-2: #38D0BE;
      --accent-ink: #0B0E17;
      --accent-soft: #1E2846;
      --good: #4ADE95;
      --card-bg: #191D2C;
      --shadow: 0 1px 2px rgba(0, 0, 0, .35), 0 10px 28px rgba(0, 0, 0, .4);
    }

    * {
      box-sizing: border-box;
    }

    body {
      background: var(--paper);
      color: var(--ink);
      font-family: 'Be Vietnam Pro', -apple-system, Segoe UI, Roboto, sans-serif;
      padding-inline: 16px;
      padding-block: 0;
      min-height: 100%;
    }

    .wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding-block: 18px 60px;
    }

    h1,
    h2,
    h3 {
      text-wrap: balance;
    }

    a {
      color: inherit;
    }

    ::selection {
      background: var(--accent-soft);
    }

    /* ---------- top bar ---------- */
    .topbar {
      position: sticky;
      top: env(safe-area-inset-top, 0px);
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 12px;
      justify-content: space-between;
      padding: 14px 4px;
      margin-inline: -4px;
      background: var(--paper);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .brand .mark {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      flex: none;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: var(--accent-ink);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 15px;
      letter-spacing: -.5px;
      box-shadow: 0 4px 12px rgba(47, 111, 237, .28);
    }

    .brand .name {
      min-width: 0;
    }

    .brand .name b {
      display: block;
      font-size: 15.5px;
      font-weight: 700;
      letter-spacing: -.1px;
    }

    .brand .name span {
      display: block;
      font-size: 12px;
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .topbtns {
      display: flex;
      gap: 8px;
      flex: none;
    }

    .iconbtn {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: var(--card-bg);
      color: var(--ink-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .iconbtn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .iconbtn:focus-visible,
    button:focus-visible,
    input:focus-visible,
    textarea:focus-visible,
    select:focus-visible,
    [tabindex]:focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    /* ---------- breadcrumb / steps ---------- */
    .steps {
      display: flex;
      gap: 6px;
      align-items: center;
      margin: 2px 0 22px;
      flex-wrap: wrap;
    }

    .step {
      font-size: 12.5px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--line);
      color: var(--muted);
      background: var(--card-bg);
    }

    .step.active {
      color: var(--accent-ink);
      background: var(--accent);
      border-color: var(--accent);
      font-weight: 600;
    }

    .step.done {
      color: var(--good);
      border-color: var(--good);
    }

    .step-sep {
      color: var(--line);
    }

    /* ---------- screens ---------- */
    .screen {
      display: none;
    }

    .screen.active {
      display: block;
    }

    /* ---------- select screen — Giao diện Cổng Dịch Vụ Công Phường Đông Hưng Thuận ---------- */
    #heroInteractiveCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    body.on-select {
      background-color: #0B3C9E;
      background-image:
        radial-gradient(600px 600px at 50% 0%, rgba(30, 120, 250, .35) 0%, rgba(30, 120, 250, 0) 70%),
        radial-gradient(560px 560px at -6% 38%, rgba(60, 130, 240, .25) 0%, rgba(60, 130, 240, 0) 70%),
        radial-gradient(640px 640px at 100% 55%, rgba(20, 80, 200, .30) 0%, rgba(20, 80, 200, 0) 70%),
        linear-gradient(180deg, #0B358F 0%, #092A75 55%, #061B4D 100%);
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    }

    html:has(body.on-select) {
      background: #061B4D;
    }

    body.on-select .topbar,
    body.on-select .steps {
      display: none;
    }

    body.on-select .wrap {
      max-width: 1640px;
      padding-block: 22px 26px;
    }

    .sel {
      position: relative;
      color: #fff;
      display: flex;
      flex-direction: column;
    }

    .sel-gear {
      position: absolute;
      top: -4px;
      right: 0;
      z-index: 5;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      cursor: pointer;
      background: rgba(255, 255, 255, .14);
      border: 1px solid rgba(255, 255, 255, .3);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all .2s;
    }

    .sel-gear:hover {
      background: rgba(255, 255, 255, .25);
      transform: rotate(30deg);
    }

    /* Hero Section */
    .hero {
      position: relative;
      padding: 0 130px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .gov-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, .12);
      border: 1px solid rgba(255, 215, 80, .4);
      padding: 5px 16px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #FFE680;
      box-shadow: 0 2px 10px rgba(0, 0, 0, .15);
      margin-bottom: 12px;
    }

    .hero-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 18px;
    }

    .hero-brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }

    .logo-tile.has-logo {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: #fff;
      padding: 3px;
      box-shadow: 0 0 0 3px rgba(255, 255, 255, .5), 0 0 30px rgba(120, 190, 255, .7);
      position: relative;
      overflow: visible;
      animation: logoFloat 6s ease-in-out infinite, logoGlow 4s ease-in-out infinite;
    }

    .logo-tile.has-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 50%;
      display: block;
    }

    .logo-tile.has-logo::after {
      content: '';
      position: absolute;
      inset: 3px;
      border-radius: 50%;
      pointer-events: none;
      background: linear-gradient(115deg, rgba(255, 255, 255, 0) 35%, rgba(255, 255, 255, .55) 50%, rgba(255, 255, 255, 0) 65%);
      background-size: 250% 100%;
      background-position: 150% 0;
      animation: logoShine 7s ease-in-out infinite;
    }

    .logo-tile.has-logo::before {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      pointer-events: none;
      background: conic-gradient(from 0deg, rgba(255, 200, 40, .12) 0deg, rgba(255, 200, 40, .12) 130deg, #FFB800 220deg, #FFD60A 290deg, #FFF36B 330deg, #FFFFFF 352deg, rgba(255, 200, 40, .12) 360deg);
      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3.5px), #000 calc(100% - 3px));
      mask: radial-gradient(farthest-side, transparent calc(100% - 3.5px), #000 calc(100% - 3px));
      filter: drop-shadow(0 0 3px #FFE45C) drop-shadow(0 0 8px rgba(255, 200, 0, .8));
      animation: neonSpin 2.8s linear infinite;
    }

    .hero-sub {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 1px;
      color: #DCEBFF;
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .hero-title {
      margin: 0;
      font-size: 38px;
      font-weight: 900;
      line-height: 1.15;
      text-transform: uppercase;
      letter-spacing: .5px;
      color: #fff;
      text-shadow: 0 3px 12px rgba(0, 15, 60, .4);
    }

    .hero-title span {
      background: linear-gradient(180deg, #FFFFFF 20%, #FFDF73 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-desc {
      margin: 8px 0 0;
      font-size: 16px;
      font-weight: 500;
      color: #BBD7FF;
      letter-spacing: .4px;
    }

    /* Quick Search Tags */
    .quick-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 14px;
      max-width: 850px;
    }

    .quick-tags-label {
      font-size: 13px;
      color: #9FC5F8;
      font-weight: 600;
    }

    .qtag {
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #EAF2FF;
      font-size: 12.5px;
      padding: 5px 14px;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.18s;
      white-space: nowrap;
      font-family: inherit;
    }

    .qtag:hover {
      background: #FFD45C;
      color: #0B2A66;
      border-color: #FFD45C;
      transform: translateY(-1px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18);
      font-weight: 600;
    }

    body.on-select .wrap {
      position: relative;
      z-index: 1;
    }

    /* chuyển động nhẹ: các vầng sáng trôi chậm trên nền */
    body.on-select::before,
    body.on-select::after {
      content: '';
      position: fixed;
      z-index: 0;
      pointer-events: none;
      border-radius: 50%;
      filter: blur(10px);
    }

    body.on-select::before {
      width: 720px;
      height: 720px;
      left: -220px;
      top: 18%;
      background: radial-gradient(circle, rgba(90, 165, 255, .42) 0%, rgba(90, 165, 255, 0) 68%);
      animation: bgDriftA 14s ease-in-out infinite alternate;
    }

    body.on-select::after {
      width: 820px;
      height: 820px;
      right: -260px;
      top: -240px;
      background: radial-gradient(circle, rgba(120, 195, 255, .32) 0%, rgba(120, 195, 255, 0) 68%);
      animation: bgDriftB 18s ease-in-out infinite alternate;
    }

    @keyframes bgDriftA {
      0% {
        transform: translate(0, 0) scale(1)
      }

      50% {
        transform: translate(180px, -60px) scale(1.12)
      }

      100% {
        transform: translate(60px, 120px) scale(.95)
      }
    }

    @keyframes bgDriftB {
      0% {
        transform: translate(0, 0) scale(1)
      }

      50% {
        transform: translate(-160px, 120px) scale(1.1)
      }

      100% {
        transform: translate(-60px, 40px) scale(1.04)
      }
    }

    @keyframes logoFloat {

      0%,
      100% {
        transform: translateY(0)
      }

      50% {
        transform: translateY(-6px)
      }
    }

    @keyframes logoGlow {

      0%,
      100% {
        box-shadow: 0 0 0 1px rgba(255, 220, 90, .35), 0 0 18px rgba(255, 200, 40, .25)
      }

      50% {
        box-shadow: 0 0 0 1px rgba(255, 230, 120, .55), 0 0 30px rgba(255, 200, 40, .4)
      }
    }

    @keyframes logoShine {

      0%,
      70% {
        background-position: 150% 0
      }

      100% {
        background-position: -50% 0
      }
    }

    @keyframes neonSpin {
      to {
        transform: rotate(360deg)
      }
    }

    /* 4 ô bay vào lần lượt khi mở trang */
    .cgrid .cat-card {
      animation: cardIn .7s cubic-bezier(.2, .9, .25, 1.15) backwards;
    }

    .cgrid .cat-card:nth-child(1) {
      animation-delay: .15s
    }

    .cgrid .cat-card:nth-child(2) {
      animation-delay: .3s
    }

    .cgrid .cat-card:nth-child(3) {
      animation-delay: .45s
    }

    .cgrid .cat-card:nth-child(4) {
      animation-delay: .6s
    }

    .cgrid .cat-card:nth-child(5) {
      animation-delay: .72s
    }

    .cgrid .cat-card:nth-child(6) {
      animation-delay: .84s
    }

    .cgrid .cat-card:nth-child(7) {
      animation-delay: .96s
    }

    @keyframes cardIn {
      from {
        opacity: 0;
        transform: translateY(60px) scale(.9)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    .gpanels .group-card.open {
      animation: gpop .5s .85s ease backwards;
    }

    .cgrid.no-intro .cat-card,
    .gpanels.no-intro .group-card.open {
      animation: none;
    }

    .search {
      width: min(860px, 100%);
      margin: 14px auto 0;
      height: 56px;
      display: flex;
      align-items: center;
      gap: 4px;
      background: #fff;
      border-radius: 999px;
      padding: 0 6px 0 22px;
      box-shadow: 0 0 0 3px rgba(150, 205, 255, .45), 0 12px 28px rgba(0, 20, 80, .3);
    }

    .search .sicon {
      color: #1D63D6;
      display: flex;
    }

    .search input {
      flex: 1;
      min-width: 0;
      height: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      font-family: inherit;
      font-size: 17px;
      color: #1B2A4A;
      padding: 0 12px;
    }

    .search input::placeholder {
      color: #6B7C98;
    }

    .searchbtn {
      flex: none;
      height: 44px;
      padding: 0 24px;
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      font-family: inherit;
      background: linear-gradient(180deg, #2F7DFF 0%, #1657E0 100%);
      color: #fff;
      font-size: 17px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(20, 80, 220, .4);
      transition: all 0.15s;
    }

    .searchbtn:hover {
      filter: brightness(1.08);
      transform: scale(1.02);
    }

    /* 4 ô nhóm */
    .cgrid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 18px;
      margin: 22px 130px 0;
    }

    .cgrid .cat-card {
      flex: 0 1 calc(25% - 13.5px);
      min-width: 0;
    }

    .cat-card {
      position: relative;
      min-height: 200px;
      border-radius: 18px;
      border: 1.5px solid rgba(255, 255, 255, .35);
      cursor: pointer;
      font-family: inherit;
      padding: 20px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 18px;
      text-align: center;
      box-shadow: 0 12px 26px rgba(0, 20, 80, .28), inset 0 1px 0 rgba(255, 255, 255, .8);
      transition: transform .14s ease, box-shadow .14s ease, border-color .14s ease;
    }

    .cat-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 34px rgba(0, 20, 80, .36), inset 0 1px 0 rgba(255, 255, 255, .8);
    }

    .cat-card.open {
      border: 3px solid #fff;
      box-shadow: 0 0 0 3px rgba(120, 190, 255, .45), 0 0 36px rgba(90, 170, 255, .85), 0 12px 26px rgba(0, 20, 80, .28);
    }

    .cat-card.open::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -17px;
      transform: translateX(-50%);
      border: 15px solid transparent;
      border-bottom: 0;
      border-top-color: #fff;
      filter: drop-shadow(0 4px 4px rgba(0, 20, 80, .2));
    }

    .cat-card .ci {
      width: 100px;
      height: 92px;
      border-radius: 24px;
      flex: none;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow: 0 10px 22px rgba(0, 20, 80, .25), inset 0 2px 0 rgba(255, 255, 255, .35);
    }

    .cat-card .cbody {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cat-card .ct {
      display: block;
      white-space: nowrap;
      font-size: 24px;
      font-weight: 800;
      line-height: 1.15;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: .2px;
      text-shadow: 0 1px 2px rgba(0, 0, 0, .12);
    }

    .cat-card .cs {
      display: block;
      margin-top: 8px;
      font-size: 17px;
      font-weight: 500;
      color: rgba(255, 255, 255, .92);
    }

    .cat-card .cs .o {
      display: none;
    }

    .cat-card.open .cs .o {
      display: inline;
    }

    .cat-card.open .cs .n {
      display: none;
    }

    .cat-card .cc {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 46px;
      height: 46px;
      border-radius: 50%;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 10px rgba(0, 0, 0, .2);
    }

    .g0 {
      background: linear-gradient(160deg, #3C9BFF 0%, #1E6FEA 55%, #1558D8 100%);
    }

    .g0 .ci {
      background: linear-gradient(160deg, #2E78F0, #1449C4);
    }

    .g1 {
      background: linear-gradient(160deg, #5FE0C4 0%, #25B79B 55%, #149A82 100%);
    }

    .g1 .ci {
      background: linear-gradient(160deg, #1FAE93, #0F8672);
    }

    .g2 {
      background: linear-gradient(160deg, #FFA5A5 0%, #F0717A 55%, #E0525E 100%);
    }

    .g2 .ci {
      background: linear-gradient(160deg, #F25A63, #D93544);
    }

    .g3 {
      background: linear-gradient(160deg, #FCE59A 0%, #F2C865 55%, #E6B04A 100%);
    }

    .g3 .ci {
      background: linear-gradient(160deg, #F2B84A, #DE9A2C);
    }

    .g3 .ct {
      color: #0B2A66;
      text-shadow: none;
    }

    .g3 .cs {
      color: #23355E;
    }

    .g4 {
      background: linear-gradient(160deg, #C3A6FF 0%, #8A5CF0 55%, #6B3DD8 100%);
    }

    .g4 .ci {
      background: linear-gradient(160deg, #8257EE, #5F2FC9);
    }

    .g5 {
      background: linear-gradient(160deg, #FFC078 0%, #F5872A 55%, #E06C0B 100%);
    }

    .g5 .ci {
      background: linear-gradient(160deg, #F2831C, #D56505);
    }

    .g6 {
      background: linear-gradient(160deg, #9CE98B 0%, #4CBE46 55%, #2E9E37 100%);
    }

    .g6 .ci {
      background: linear-gradient(160deg, #45B641, #28912F);
    }

    .cat-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background: linear-gradient(115deg, rgba(255, 255, 255, .22) 0%, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, 0) 62%, rgba(255, 255, 255, .12) 100%);
    }

    .cat-hint {
      margin: 14px 130px 0;
      text-align: center;
      color: #CFE6FF;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .sel.searching .cat-hint,
    .sel.searching .cgrid {
      display: none;
    }

    .sel.has-open .cat-hint {
      display: none;
    }

    .sel.has-open .gpanels {
      margin-top: 26px;
    }

    /* danh sách xổ xuống */
    .gpanels {
      margin: 12px 130px 0;
    }

    .sel.searching .gpanels {
      margin-top: 24px;
    }

    .group-card {
      display: none;
      background: rgba(255, 255, 255, .97);
      border: 1px solid rgba(255, 255, 255, .9);
      border-radius: 18px;
      padding: 12px 22px 16px;
      box-shadow: 0 14px 30px rgba(0, 20, 80, .3);
      color: #1B2A4A;
      animation: gpop .2s ease;
    }

    @keyframes gpop {
      from {
        opacity: 0;
        transform: translateY(-8px)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    .group-card.open {
      display: block;
    }

    .sel.searching .group-card {
      display: block;
      margin-bottom: 14px;
    }

    .grp-head {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 10px;
      cursor: pointer;
    }

    .grp-head .gicon {
      flex: none;
      width: 44px;
      height: 44px;
      border-radius: 11px;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 10px rgba(20, 80, 220, .3);
    }

    .grp-head .gttl {
      flex: 1;
      min-width: 0;
      font-size: 21px;
      font-weight: 700;
      color: #0B2A66;
      line-height: 1.25;
    }

    .grp-head .gttl small {
      font-size: 14px;
      font-weight: 500;
      color: #5B6B88;
      margin-left: 6px;
    }

    .grp-count {
      flex: none;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #1D63D6;
      font-size: 17px;
      font-weight: 500;
    }

    .sel.searching .grp-count svg {
      display: none;
    }

    .card-grid {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    /* tiêu đề nhóm con bên trong một mảng (dùng cho Hộ tịch) */
    .grp-sub {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 14px 0 2px;
      font-size: 15px;
      font-weight: 700;
      color: #1D5FD8;
      text-transform: uppercase;
      letter-spacing: .3px;
    }

    .grp-sub:first-child {
      margin-top: 0;
    }

    .grp-sub::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, #CBDDF8, rgba(203, 221, 248, 0));
    }

    .grp-sub small {
      margin-left: 6px;
      font-size: 12.5px;
      font-weight: 500;
      color: #5B6B88;
      text-transform: none;
      letter-spacing: 0;
    }

    .sel.searching .grp-sub {
      display: none;
    }

    .form-card {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 18px;
      text-align: left;
      cursor: pointer;
      font-family: inherit;
      background: #fff;
      border: 1px solid #E1E9F6;
      border-radius: 10px;
      padding: 4px 18px 4px 5px;
      min-height: 40px;
      box-shadow: 0 1px 3px rgba(20, 50, 120, .06);
      transition: border-color .12s ease, background .12s ease;
    }

    .form-card:hover {
      border-color: #9EC2FF;
      background: #F4F8FF;
    }

    .form-card .num {
      flex: none;
      width: 56px;
      height: 30px;
      border-radius: 8px;
      background: #E3EEFF;
      color: #1D5FD8;
      font-size: 20px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .form-card .ttl {
      flex: 1;
      min-width: 0;
      font-size: 18px;
      font-weight: 500;
      line-height: 1.3;
      color: #1B2A4A;
    }

    .form-card .fchev {
      flex: none;
      color: #1D63D6;
    }

    .form-card.hidden,
    .group-card.hidden {
      display: none !important;
    }

    .no-results {
      color: #D6E6FF;
      font-size: 16px;
      padding: 18px 130px;
    }

    /* BẢNG THÔNG TIN LIÊN HỆ & TÀI KHOẢN NỘP PHÍ CHÍNH THỨC (FOOTER HUB) */
    .official-footer-card {
      margin: 28px 130px 0;
      background: rgba(255, 255, 255, 0.97);
      border: 1.5px solid rgba(255, 255, 255, 0.95);
      border-radius: 20px;
      padding: 22px 28px 18px;
      box-shadow: 0 14px 34px rgba(0, 20, 80, .28);
      color: #1B2A4A;
    }

    .ofc-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1.5px solid #E6EFFD;
      padding-bottom: 12px;
      margin-bottom: 16px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .ofc-header-title {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .ofc-header-title .ofc-icon {
      font-size: 24px;
    }

    .ofc-header-title b {
      font-size: 15.5px;
      font-weight: 800;
      color: #0B2A66;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .ofc-header-sub {
      font-size: 12.5px;
      color: #5B6B88;
      font-weight: 600;
      background: #F0F5FD;
      padding: 4px 12px;
      border-radius: 999px;
    }

    .ofc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 18px;
      font-size: 13.5px;
    }

    .ofc-box {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .ofc-box-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex: none;
    }

    .ofc-box-icon.phone {
      background: #EAF2FF;
      color: #1D5FD8;
      box-shadow: 0 2px 8px rgba(29, 95, 216, 0.15);
    }

    .ofc-box-icon.address {
      background: #E8F8F0;
      color: #148A4E;
      box-shadow: 0 2px 8px rgba(20, 138, 78, 0.15);
    }

    .ofc-box-icon.bank {
      background: #FFF4E5;
      color: #D97706;
      box-shadow: 0 2px 8px rgba(217, 119, 6, 0.15);
    }

    .ofc-box-label {
      font-weight: 700;
      color: #0B2A66;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .ofc-subbar {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px dashed #CBDDF8;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      font-size: 12.5px;
    }

    .ofc-fb-link {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ofc-fb-icon {
      display: inline-flex;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #1877F2;
      color: #fff;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 12px;
    }

    .ofc-fb-link a {
      color: #1D5FD8;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .ofc-fb-link a:hover {
      text-decoration: underline;
    }

    .ofc-hours {
      color: #556987;
      font-size: 12px;
      font-weight: 600;
    }

    /* 3 GIÁ TRỊ CỐT LÕI (NHANH CHÓNG - AN TOÀN - THUẬN TIỆN) */
    .ofc-values {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid #EAF2FF;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      text-align: center;
    }

    .ofc-val-item {
      background: linear-gradient(180deg, #F8FAFC 0%, #EDF4FF 100%);
      border: 1px solid #DFECFC;
      border-radius: 10px;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-align: left;
    }

    .ofc-val-item .vi {
      font-size: 22px;
      flex: none;
    }

    .ofc-val-item b {
      display: block;
      font-size: 13px;
      font-weight: 800;
      color: #0B2A66;
      text-transform: uppercase;
      letter-spacing: 0.2px;
    }

    .ofc-val-item span {
      display: block;
      font-size: 11.5px;
      color: #5B6B88;
      font-weight: 500;
    }

    @media (max-width:1299px) {

      .hero,
      .cgrid,
      .gpanels,
      .cat-hint,
      .official-footer-card {
        margin-left: 0;
        margin-right: 0;
        padding-left: 0;
        padding-right: 0;
      }

      .cgrid .cat-card {
        flex-basis: calc(50% - 9px);
      }

      .cat-card.open::after {
        display: none;
      }
    }

    @media (max-width:640px) {
      .hero-title {
        font-size: 26px;
      }

      .hero-sub {
        font-size: 13px;
      }

      .hero-desc {
        font-size: 13.5px;
      }

      .logo-tile.has-logo {
        width: 86px;
        height: 86px;
      }

      .sel-gear {
        top: -10px;
        right: -6px;
      }

      .search {
        height: 54px;
        padding-left: 14px;
      }

      .searchbtn {
        height: 44px;
        padding: 0 16px;
        font-size: 16px;
      }

      .search input {
        font-size: 15px;
      }

      .cgrid {
        gap: 10px;
        margin-top: 18px;
      }

      .cgrid .cat-card {
        flex-basis: calc(50% - 5px);
      }

      .cat-card {
        min-height: 176px;
        padding: 14px 8px;
      }

      .cat-card .ci {
        width: 76px;
        height: 72px;
        border-radius: 20px;
      }

      .cat-card .ci svg {
        width: 44px;
        height: 44px;
      }

      .cat-card .ct {
        font-size: 14px;
        white-space: normal;
      }

      .cat-card .cs {
        font-size: 12.5px;
      }

      .cat-card .cc {
        width: 28px;
        height: 28px;
      }

      .cat-card.open::after {
        display: none;
      }

      .group-card {
        padding: 12px 12px 14px;
      }

      .grp-head .gttl {
        font-size: 16px;
      }

      .grp-count {
        font-size: 14px;
      }

      .form-card .num {
        width: 40px;
        font-size: 16px;
      }

      .form-card .ttl {
        font-size: 15.5px;
      }

      .official-footer-card {
        margin-top: 20px;
        padding: 14px 14px;
      }

      .ofc-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .ofc-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .ofc-subbar {
        flex-direction: column;
        align-items: flex-start;
      }

      .ofc-values {
        grid-template-columns: 1fr;
        gap: 8px;
      }
    }

    .tk-toast {
      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translate(-50%, 20px);
      max-width: min(92vw, 520px);
      z-index: 200;
      background: #0B2A66;
      color: #fff;
      font-size: 14.5px;
      line-height: 1.45;
      padding: 12px 16px;
      border-radius: 12px;
      box-shadow: 0 10px 28px rgba(0, 20, 80, .35);
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease, transform .2s ease;
    }

    .tk-toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    /* ---------- bản in từ file Word ---------- */
    .wdoc .wp {
      margin: 0 0 5px;
      min-height: 1.2em;
      white-space: normal;
    }

    .wdoc .wtb {
      width: 100%;
      border-collapse: collapse;
      margin: 8px 0;
    }

    .wdoc .wtb td {
      vertical-align: top;
      padding: 2px 8px;
    }

    .wdoc .wtb .wp {
      margin-bottom: 3px;
    }

    .adm-docprev {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 18px 22px;
      max-height: 520px;
      overflow: auto;
      background: #fff;
      color: #1C1A16;
    }

    .adm-fields {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    .adm-fields th {
      text-align: left;
      font-size: 12.5px;
      color: var(--muted);
      font-weight: 600;
      padding: 6px 8px;
      border-bottom: 1px solid var(--line);
    }

    .adm-fields td {
      padding: 5px 8px;
      border-bottom: 1px solid var(--line);
      vertical-align: middle;
    }

    .adm-fields input {
      width: 100%;
      font: inherit;
      font-size: 14px;
      padding: 7px 10px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: var(--paper);
      color: var(--ink);
    }

    .adm-fields .sec td {
      background: var(--paper-2);
      font-weight: 700;
      color: #0B3A93;
    }

    .adm-upload {
      display: inline-flex;
    }

    .adm-upload input {
      display: none;
    }

    .adm-2col {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 16px;
    }

    @media (max-width:900px) {
      .adm-2col {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- quản trị mẫu ---------- */
    #screen-admin .hint {
      color: var(--muted);
      font-size: 13px;
      margin: 2px 0 10px;
    }

    .adm-top {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }

    .adm-top h2 {
      margin: 0;
      font-size: 22px;
      font-weight: 800;
    }

    .adm-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
      margin-top: 12px;
    }

    .adm-actions.left {
      justify-content: flex-start;
    }

    .adm-top .adm-actions {
      margin-top: 0;
    }

    .adm-card {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 16px 18px;
      margin-bottom: 14px;
      box-shadow: var(--shadow);
    }

    .adm-card h3 {
      margin: 0 0 10px;
      font-size: 17px;
      font-weight: 800;
    }

    .adm-card h3 .cnt {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--muted);
      margin-left: 6px;
    }

    .adm-card h4 {
      margin: 18px 0 8px;
      font-size: 15px;
    }

    .adm-login {
      max-width: 440px;
      margin: 30px auto;
    }

    .adm-login .field input {
      width: 100%;
    }

    .adm-err {
      color: #C0362C;
      font-size: 13.5px;
      min-height: 18px;
      margin: 6px 0;
    }

    .adm-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 4px;
      border-top: 1px solid var(--line);
    }

    .adm-row:first-of-type {
      border-top: 0;
    }

    .adm-row .num {
      flex: none;
      width: 34px;
      height: 28px;
      border-radius: 8px;
      background: #E3EEFF;
      color: #1D5FD8;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .adm-row .t {
      flex: 1;
      min-width: 0;
      font-size: 15px;
    }

    .adm-row.is-hidden .t {
      color: var(--muted);
      text-decoration: line-through;
    }

    .adm-row .tag {
      font-style: normal;
      font-size: 11.5px;
      font-weight: 700;
      color: #1D5FD8;
      background: #E3EEFF;
      border-radius: 6px;
      padding: 1px 6px;
      margin-left: 4px;
      text-decoration: none;
      display: inline-block;
    }

    .adm-row .tag.off {
      color: #8A5A00;
      background: #FFF1D0;
    }

    .btn.sm {
      padding: 6px 12px;
      font-size: 13px;
      border-radius: 9px;
    }

    .btn.danger {
      color: #C0362C;
    }

    .btn.danger:hover {
      border-color: #C0362C;
      color: #C0362C;
    }

    .sw {
      position: relative;
      flex: none;
      width: 42px;
      height: 24px;
      cursor: pointer;
    }

    .sw input {
      opacity: 0;
      width: 0;
      height: 0;
      position: absolute;
    }

    .sw span {
      position: absolute;
      inset: 0;
      border-radius: 99px;
      background: #CBD2E1;
      transition: background .15s;
    }

    .sw span::after {
      content: '';
      position: absolute;
      left: 3px;
      top: 3px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #fff;
      transition: transform .15s;
      box-shadow: 0 1px 3px rgba(0, 0, 0, .2);
    }

    .sw input:checked+span {
      background: #1F9D67;
    }

    .sw input:checked+span::after {
      transform: translateX(18px);
    }

    .fe-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 16px;
    }

    .fe-grid .wide {
      grid-column: 1 / -1;
    }

    .fe-grid input,
    .fe-grid select,
    .fe-grid textarea,
    .fe-row input,
    .fe-row select {
      width: 100%;
      font: inherit;
      font-size: 14px;
      padding: 9px 11px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--paper);
      color: var(--ink);
    }

    .fe-grid textarea {
      min-height: 60px;
    }

    .chk {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      font-size: 14px;
      margin: 8px 0;
      cursor: pointer;
    }

    .fe-grid .chk input {
      width: 18px;
      height: 18px;
      padding: 0;
      flex: none;
    }

    .fe-row {
      display: grid;
      grid-template-columns: 170px 1.4fr 1fr 1fr auto;
      gap: 8px;
      align-items: center;
      padding: 6px 0;
      border-top: 1px dashed var(--line);
    }

    .fe-row.sec {
      grid-template-columns: 170px 1fr auto;
    }

    .fe-row [hidden] {
      display: block !important;
      visibility: hidden;
    }

    .fe-badge {
      font-size: 13px;
      font-weight: 700;
      color: #1D5FD8;
    }

    .fe-row.sec input {
      font-weight: 700;
    }

    .fe-btns {
      display: flex;
      gap: 4px;
    }

    .fe-btns button {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--card-bg);
      cursor: pointer;
      color: var(--ink-soft);
      font-size: 14px;
    }

    .fe-btns button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    @media (max-width:760px) {
      .fe-grid {
        grid-template-columns: 1fr;
      }

      .fe-row,
      .fe-row.sec {
        grid-template-columns: 1fr;
      }

      .fe-row [hidden] {
        display: none !important;
      }

      .adm-row {
        flex-wrap: wrap;
      }
    }

    /* ---------- form screen ---------- */

    .panel {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px clamp(14px, 3vw, 28px);
    }

    .panel-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .panel-head h2 {
      font-weight: 800;
      letter-spacing: -.2px;
      font-size: 20px;
      margin: 0 0 4px;
    }

    .panel-head .meta {
      font-size: 12.5px;
      color: var(--muted);
    }

    .backlink {
      font: inherit;
      font-size: 14px;
      font-weight: 700;
      padding: 10px 18px;
      margin-bottom: 14px;
      border-radius: 12px;
      border: 1px solid transparent;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent-ink);
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      box-shadow: 0 6px 16px rgba(47, 111, 237, .28);
      transition: transform .1s ease, opacity .15s ease;
    }

    .backlink:hover {
      opacity: .94;
    }

    .backlink:active {
      transform: translateY(1px);
    }

    fieldset {
      border: none;
      padding: 0;
      margin: 0 0 22px;
    }

    /* mục tùy chọn: gập lại cho form đỡ dài */
    fieldset.fs-opt>.fs-legend {
      cursor: pointer;
      user-select: none;
    }

    fieldset.fs-opt>.fs-legend:hover {
      color: #1245A8;
    }

    .fs-toggle {
      margin-left: 10px;
      padding: 2px 10px;
      border-radius: 20px;
      background: #EEF4FF;
      border: 1px solid #CBDDF8;
      color: #1D5FD8;
      font-size: 11px;
      font-weight: 600;
      text-transform: none;
      letter-spacing: 0;
    }

    fieldset.fs-opt.collapsed {
      margin-bottom: 10px;
    }

    fieldset.fs-opt.collapsed>.fs-inner {
      display: none;
    }

    .fs-note {
      margin: -2px 0 12px;
      font-size: 12.5px;
      color: var(--muted);
      line-height: 1.45;
    }

    .fs-legend {
      font-size: 14px;
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--line);
    }

    .field-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px 16px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .field.wide {
      grid-column: 1 / -1;
    }

    .field label {
      font-size: 13px;
      color: var(--ink-soft);
      font-weight: 500;
    }

    .field label .req {
      color: var(--accent);
    }

    .field label .note {
      color: var(--muted);
      font-weight: 400;
    }

    .field input[type=text],
    .field input[type=number],
    .field input[type=date],
    .field select,
    .field textarea {
      font: inherit;
      font-size: 14px;
      padding: 9px 11px;
      border-radius: 9px;
      border: 1px solid var(--line);
      background: var(--paper);
      color: var(--ink);
      width: 100%;
    }

    .field textarea {
      resize: vertical;
      min-height: 64px;
      font-family: inherit;
    }

    .inputmic {
      display: flex;
      align-items: stretch;
      gap: 6px;
    }

    .inputmic input,
    .inputmic textarea {
      flex: 1;
      min-width: 0;
    }

    .micbtn {
      flex: none;
      width: 38px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: var(--card-bg);
      color: var(--muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .micbtn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .micbtn.listening {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-ink);
      animation: micpulse 1.1s ease-in-out infinite;
    }

    .micbtn[disabled] {
      opacity: .35;
      cursor: not-allowed;
    }

    @keyframes micpulse {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: .55;
      }
    }

    .voice-hint {
      font-size: 11.5px;
      color: var(--muted);
      margin-top: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* thanh thông tin người khai dùng chung */
    .profile-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 12px;
      padding: 10px 14px;
      border-radius: 11px;
      background: #EAF4EC;
      border: 1px solid #BCDFC4;
      color: #145B2A;
      font-size: 13px;
    }

    .profile-bar[hidden] {
      display: none;
    }

    .profile-bar .pb-ic {
      flex: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #1E8E3E;
      color: #fff;
      font-size: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .profile-bar .pb-tx {
      flex: 1;
      min-width: 180px;
      line-height: 1.45;
    }

    .profile-bar .pb-clear {
      flex: none;
      border: 1px solid #9FCDA9;
      background: #fff;
      color: #145B2A;
      border-radius: 8px;
      padding: 5px 11px;
      font-family: inherit;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
    }

    .profile-bar .pb-clear:hover {
      background: #F2FAF4;
      border-color: #1E8E3E;
    }

    /* gợi ý nhỏ dưới ô nhập + nhãn "dùng chung" */
    .fhint {
      font-size: 11.5px;
      color: var(--muted);
      margin-top: 4px;
      line-height: 1.4;
    }

    .stdtag {
      display: inline-block;
      margin-left: 6px;
      padding: 1px 7px;
      border-radius: 20px;
      background: #E7F1FF;
      color: #1D5FD8;
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .3px;
      vertical-align: middle;
    }

    /* nút chép thông tin từ mục khác */
    .copybtn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 14px;
      border-radius: 9px;
      cursor: pointer;
      border: 1px solid #BBD4FA;
      background: #F2F7FF;
      color: #1D5FD8;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
    }

    .copybtn:hover {
      background: #E4EFFF;
      border-color: #1D5FD8;
    }

    /* ô tra ngành, nghề kinh doanh */
    .nganhbox {
      position: relative;
    }

    .nganhlist {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 4px);
      z-index: 20;
      max-height: 300px;
      overflow-y: auto;
      background: #fff;
      border: 1px solid #CBDDF8;
      border-radius: 11px;
      box-shadow: 0 12px 28px rgba(10, 40, 100, .16);
      padding: 5px;
    }

    .nganhlist[hidden] {
      display: none;
    }

    .nganh-item {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      width: 100%;
      text-align: left;
      padding: 8px 10px;
      border: 0;
      background: transparent;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      font-size: 13.5px;
      line-height: 1.4;
      color: var(--ink);
    }

    .nganh-item:hover {
      background: #EEF5FF;
    }

    .nganh-ma {
      flex: none;
      min-width: 44px;
      padding: 1px 7px;
      border-radius: 6px;
      background: #E3EEFF;
      color: #1D5FD8;
      font-weight: 700;
      font-size: 12.5px;
      text-align: center;
    }

    .nganh-none {
      padding: 10px 12px;
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
    }

    .nganh-near {
      padding: 7px 11px 6px;
      font-size: 12px;
      color: #8A6400;
      background: #FFF6E0;
      border-radius: 7px;
      margin-bottom: 3px;
    }

    .checkfield .checkline {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      font-size: 14px;
      font-weight: 400;
      color: var(--ink);
      cursor: pointer;
      line-height: 1.45;
    }

    .checkfield .checkline input {
      flex: none;
      width: 17px;
      height: 17px;
      margin-top: 1px;
      accent-color: #1D5FD8;
      cursor: pointer;
    }

    .radiorow {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      padding-top: 6px;
    }

    .radiorow label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 400;
      color: var(--ink);
    }

    .actionbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-top: 6px;
      flex-wrap: wrap;
    }

    .btn {
      font: inherit;
      font-size: 14px;
      font-weight: 700;
      padding: 11px 20px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: var(--card-bg);
      color: var(--ink);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: transform .1s ease, box-shadow .15s ease, opacity .15s ease;
    }

    .btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn.primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border-color: transparent;
      color: var(--accent-ink);
      box-shadow: 0 6px 16px rgba(47, 111, 237, .28);
    }

    .btn.primary:hover {
      opacity: .94;
      color: var(--accent-ink);
    }

    .btn.ghost {
      border-color: transparent;
      background: transparent;
    }

    .btn:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    /* ---------- preview / document ---------- */
    .preview-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    /* The document preview always renders as a white printed page, regardless of app theme —
   it represents the physical paper the citizen will sign, not themed UI chrome. */
    .doc-shell {
      background: #FFFFFF;
      border: 1px solid #E6E0D2;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: clamp(20px, 4vw, 50px);
      max-width: 760px;
      margin: 0 auto;
    }

    .doc {
      font-family: 'Noto Serif', Georgia, 'Times New Roman', serif;
      color: #1C1A16;
      font-size: 14.5px;
      line-height: 1.55;
    }

    .doc-head {
      text-align: center;
      margin-bottom: 4px;
    }

    .quochieu {
      font-weight: 700;
      text-transform: uppercase;
      font-size: 14px;
      letter-spacing: .3px;
    }

    .tieungu {
      font-weight: 600;
      font-size: 13.5px;
      position: relative;
      display: inline-block;
      margin-top: 2px;
      padding-bottom: 4px;
    }

    .tieungu::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
      width: 46%;
      border-bottom: 1px solid #1C1A16;
    }

    .doc-title {
      text-align: center;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 17px;
      margin: 20px 0 2px;
      font-family: 'Source Serif 4', serif;
    }

    .doc-sub {
      text-align: center;
      font-size: 11.5px;
      color: #8A8272;
      margin-bottom: 16px;
    }

    .kinhgui {
      margin: 14px 0 12px;
      text-align: center;
    }

    .kinhgui b {
      font-weight: 600;
    }

    .doc-body {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .fline {
      padding: 2px 0;
    }

    .flabel {
      color: #5B5346;
    }

    .flabel sup {
      font-size: 9px;
    }

    .blank {
      display: inline-block;
      min-width: 80px;
      border-bottom: 1px dotted #9C9484;
      height: 1.05em;
      vertical-align: bottom;
    }

    .filled {
      font-weight: 600;
    }

    .section-hd {
      font-weight: 700;
      margin: 14px 0 4px;
    }

    .twocol {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 22px;
      margin: 6px 0;
    }

    .twocol .colhd {
      font-weight: 700;
      text-align: center;
      margin-bottom: 4px;
      text-decoration: underline;
    }

    .para {
      margin: 10px 0;
    }

    .camdoan {
      margin: 16px 0 4px;
    }

    .madeAt {
      margin: 4px 0 6px;
      font-style: italic;
    }

    .siggrid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 6px;
    }

    .siggrid.single {
      grid-template-columns: 1fr;
      justify-items: end;
    }

    .sigbox {
      text-align: center;
      width: min(260px, 100%);
    }

    .sigbox .who {
      font-weight: 700;
    }

    .sigbox .instr {
      font-size: 11.5px;
      color: #8A8272;
      font-style: italic;
      margin-bottom: 6px;
    }

    .sigline {
      width: 100%;
      height: 88px;
    }

    .signame {
      margin-top: 6px;
      font-weight: 600;
    }

    .print-hint {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--ink-soft);
      background: var(--paper-2);
      border: 1px dashed var(--line);
      border-radius: 10px;
      padding: 10px 14px;
      margin-bottom: 16px;
    }

    .footnote {
      margin-top: 26px;
      padding-top: 14px;
      border-top: 1px dashed #E6E0D2;
      font-size: 11px;
      color: #8A8272;
      line-height: 1.6;
    }

    .donebar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 22px;
      flex-wrap: wrap;
    }

    .counter {
      font-size: 12.5px;
      color: var(--muted);
    }

    /* ---------- settings modal ---------- */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(20, 16, 10, .45);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 16px;
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: var(--shadow);
      width: min(440px, 100%);
      padding: 22px;
    }

    .modal h3 {
      margin: 0 0 4px;
      font-weight: 800;
    }

    .modal p.hint {
      color: var(--muted);
      font-size: 13px;
      margin: 0 0 16px;
    }

    .modal .field {
      margin-bottom: 14px;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 6px;
    }

    /* ---------- print ---------- */
    @page {
      size: A4;
      margin: 0;
    }

    /* margin 0: trình duyệt không in ngày giờ, tiêu đề, đường link ở đầu/cuối trang */
    @media print {

      *,
      *::before,
      *::after {
        animation: none !important;
        transition: none !important;
        filter: none !important;
        backdrop-filter: none !important;
        box-shadow: none !important;
        text-shadow: none !important;
      }

      html,
      body {
        background: #fff !important;
        margin: 0 !important;
        padding: 0 !important;
        min-height: 0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      canvas,
      #heroInteractiveCanvas {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
        visibility: hidden !important;
      }

      body>*:not(.wrap) {
        display: none !important;
      }

      .wrap {
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .wrap>*:not(#screen-preview) {
        display: none !important;
      }

      #screen-preview {
        display: block !important;
      }

      #screen-preview>*:not(.doc-shell) {
        display: none !important;
      }

      .doc-shell {
        position: static;
        box-shadow: none !important;
        border: none !important;
        border-radius: 0 !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 12mm 16mm 10mm !important;
        background: #fff !important;
      }

      .doc,
      .wdoc {
        font-family: 'Times New Roman', Times, 'Noto Serif', Georgia, serif !important;
        color: #000 !important;
      }

      .doc .footnote {
        display: none !important;
      }

      .sigline {
        height: 75px;
      }
    }

    @media (max-width:640px) {
      .twocol {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .siggrid {
        grid-template-columns: 1fr;
      }

      .sigbox {
        width: 100%;
        justify-self: stretch;
      }
    }
  </style>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap"
    rel="stylesheet">

  <canvas id="heroInteractiveCanvas"></canvas>
  <div class="wrap">

    <div class="topbar">
      <div class="brand">
        <div class="mark">TK</div>
        <div class="name">
          <b>Trung tâm Cung ứng Dịch vụ công phường Đông Hưng Thuận</b>
          <span id="officeLabel">Ủy ban nhân dân Phường Đông Hưng Thuận</span>
        </div>
      </div>
      <div class="topbtns">
        <button class="iconbtn" id="settingsBtn" title="Cài đặt cơ quan tiếp nhận" aria-label="Cài đặt">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="3" />
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
        </button>
      </div>
    </div>

    <div class="steps" id="stepsBar"></div>

    <!-- SCREEN 1: chọn loại tờ khai -->
    <section class="screen" id="screen-select">
      <div class="sel">
        <button class="sel-gear" id="settingsBtn2" type="button" title="Cài đặt cơ quan tiếp nhận" aria-label="Cài đặt">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
            <circle cx="12" cy="12" r="3" />
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.820-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.650 1.650 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
        </button>

        <div class="hero">
          <div class="gov-badge">
            <span>⭐ Cổng dịch vụ công trực tuyến ⭐</span>
          </div>

          <div class="hero-brand">
            <div class="logo-tile has-logo" id="brandLogo">
              <img src="./logo.png" alt="Logo Đông Hưng Thuận">
            </div>
          </div>

          <div class="hero-header">
            <div class="hero-sub">Trung tâm Cung ứng Dịch vụ công</div>
            <h1 class="hero-title">Phường <span>Đông Hưng Thuận</span></h1>
            <p class="hero-desc">Hệ thống Tờ khai Điện tử & Hướng dẫn Thủ tục Hành chính Công</p>
          </div>

          <div class="search">
            <span class="sicon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.4" stroke-linecap="round">
                <circle cx="10.5" cy="10.5" r="6.5" />
                <path d="M20 20l-4.6-4.6" />
              </svg></span>
            <input type="text" id="searchInput"
              placeholder="Tìm loại giấy tờ… (VD: khai sinh, kết hôn, xác nhận tình trạng hôn nhân)" autocomplete="off">
            <button type="button" class="searchbtn" id="searchGoBtn">Tìm kiếm
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12h15M13 6l6 6-6 6" />
              </svg>
            </button>
          </div>

          <div class="quick-tags">
            <span class="quick-tags-label">Gợi ý nhanh:</span>
            <button type="button" class="qtag" onclick="quickFilter('khai sinh')">Khai sinh</button>
            <button type="button" class="qtag" onclick="quickFilter('kết hôn')">Kết hôn</button>
            <button type="button" class="qtag" onclick="quickFilter('khai tử')">Khai tử</button>
            <button type="button" class="qtag" onclick="quickFilter('tình trạng hôn nhân')">Tình trạng hôn nhân</button>
            <button type="button" class="qtag" onclick="quickFilter('đất đai')">Đất đai</button>
            <button type="button" class="qtag" onclick="quickFilter('hộ kinh doanh')">Hộ kinh doanh</button>
            <button type="button" class="qtag" onclick="quickFilter('hỏa táng')">Hỏa táng</button>
          </div>
        </div>

        <div class="cgrid" id="quickGrid"></div>
        <div class="cat-hint" id="catHint"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9.5" />
            <path d="M12 11v6M12 7.5v.5" stroke-linecap="round" />
          </svg>Chọn một nhóm thủ tục để xem danh sách chi tiết</div>
        <div class="gpanels" id="cardGroups"></div>
        <div class="no-results" id="noResults" hidden>Không tìm thấy loại giấy tờ phù hợp. Thử từ khóa khác nhé.</div>

        <!-- THÔNG TIN LIÊN HỆ & TÀI KHOẢN NỘP PHÍ CHÍNH THỨC -->
        <div class="official-footer-card">
          <div class="ofc-header">
            <div class="ofc-header-title">
