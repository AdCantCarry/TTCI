hân vào đâu", "", ""], ["9510", "Sửa chữa, bảo dưỡng máy tính, thiết bị thông tin và truyền thông", "", ""], ["9521", "Sửa chữa, bảo dưỡng thiết bị nghe nhìn điện tử gia dụng", "sửa tivi; sửa điện tử; sửa loa; sửa amply", ""], ["9522", "Sửa chữa, bảo dưỡng thiết bị, đồ dùng gia đình", "sửa máy giặt; sửa tủ lạnh; điện lạnh; sửa máy lạnh; sửa quạt; sửa bếp từ", ""], ["9523", "Sửa chữa, bảo dưỡng giày, dép, hàng da và giả da", "", ""], ["9524", "Sửa chữa, bảo dưỡng giường, tủ, bàn, ghế và đồ nội thất tương tự", "", ""], ["9529", "Sửa chữa, bảo dưỡng xe đạp, đồng hồ, đồ dùng cá nhân và gia đình khác chưa được phân vào đâu", "sửa xe đạp; sửa đồng hồ; sửa giày; sửa khóa; sửa dù; mài dao", ""], ["9531", "Sửa chữa, bảo dưỡng ô tô và xe có động cơ khác", "sửa ô tô; gara ô tô; đồng sơn ô tô", ""], ["9532", "Sửa chữa, bảo dưỡng mô tô, xe máy", "sửa xe máy; tiệm sửa xe; thay nhớt; rửa xe; vá xe; tiệm xe", ""], ["9540", "Hoạt động dịch vụ trung gian cho sửa chữa, bảo dưỡng máy tính, đồ dùng cá nhân và gia đình, ô tô, mô tô, xe máy và xe có động cơ khác", "", ""], ["9610", "Giặt là, làm sạch các sản phẩm dệt và lông thú", "giặt ủi; giặt sấy; giặt là; giặt thảm", ""], ["9621", "Dịch vụ làm tóc", "cắt tóc; hớt tóc; salon tóc; gội đầu; uốn tóc; tiệm tóc; làm tóc; barber", ""], ["9622", "Dịch vụ chăm sóc sắc đẹp và các hoạt động làm đẹp khác", "nail; làm móng; spa; massage; thẩm mỹ; chăm sóc da; phun xăm; tiệm nail", ""], ["9623", "Dịch vụ spa và xông hơi", "", ""], ["9630", "Hoạt động dịch vụ phục vụ tang lễ và các dịch vụ liên quan", "", ""], ["9640", "Hoạt động trung gian cho dịch vụ cá nhân", "", ""], ["9690", "Hoạt động dịch vụ phục vụ cá nhân khác", "", "Hoạt động dịch vụ phục vụ hôn lễ và các dịch vụ liên quan; Hoạt động dịch vụ phục vụ cá nhân khác chưa được phân vào đâu"], ["9700", "Hoạt động làm thuê công việc gia đình trong các hộ gia đình", "", ""], ["9810", "Hoạt động sản xuất các sản phẩm vật chất tự tiêu dùng của hộ gia đình", "", ""], ["9820", "Hoạt động sản xuất các sản phẩm dịch vụ tự tiêu dùng của hộ gia đình", "", ""], ["9900", "Hoạt động của các tổ chức và cơ quan quốc tế", "", ""]];

      var SUGGEST = {
        xaPhuong: ['Đông Hưng Thuận'],
        tinhTP: ['TP. Hồ Chí Minh'],
        diaChi: ['Phan Văn Hớn']
      };
      function rememberSuggest(kind, val) {
        val = String(val || '').trim();
        if (!val || !SUGGEST[kind] || SUGGEST[kind].indexOf(val) !== -1) return;
        SUGGEST[kind].push(val);
        if (SUGGEST[kind].length > 40) SUGGEST[kind].shift();
      }
      /* bỏ dấu tiếng Việt để gõ "tap hoa" vẫn tìm ra "tạp hóa" */
      function boDau(s) {
        return String(s || '').toLowerCase()
          .replace(/[àáạảãâầấậẩẫăằắặẳẵ]/g, 'a').replace(/[èéẹẻẽêềếệểễ]/g, 'e')
          .replace(/[ìíịỉĩ]/g, 'i').replace(/[òóọỏõôồốộổỗơờớợởỡ]/g, 'o')
          .replace(/[ùúụủũưừứựửữ]/g, 'u').replace(/[ỳýỵỷỹ]/g, 'y').replace(/đ/g, 'd');
      }
      /* tìm ngành và xếp hạng: khớp nguyên cụm đứng trên khớp từng chữ rời,
         cách gọi dân dã đứng trên tên ngành chi tiết bên trong */
      function timNganh(q) {
        q = boDau(q).replace(/\s+/g, ' ').trim();
        if (!q) return NGANH_NGHE.slice(0, 12);
        var tu = q.split(' ');
        var ra = [];
        for (var i = 0; i < NGANH_NGHE.length; i++) {
          var n = NGANH_NGHE[i];
          var ten = boDau(n[1]), dan = boDau(n[2] || ''), chi = boDau(n[3] || ''), ma = n[0];
          var kho = ten + ' ' + dan, tatCa = kho + ' ' + chi;
          var d = 0;
          if (ma.indexOf(q.replace(/\s/g, '')) === 0) d = 120;
          else if (dan.indexOf(q) !== -1) d = 100;
          else if (ten.indexOf(q) !== -1) d = 90;
          else if (chi.indexOf(q) !== -1) d = 70;
          else if (tu.every(function (t) { return kho.indexOf(t) !== -1; })) d = 45;
          else if (tu.every(function (t) { return tatCa.indexOf(t) !== -1; })) d = 30;
          else {
            // không khớp đủ chữ thì vẫn gợi ý ngành gần nhất, xếp theo số chữ khớp được
            var hitKho = 0, hitTat = 0;
            tu.forEach(function (t) {
              if (t.length < 3) return;
              if (kho.indexOf(t) !== -1) hitKho++;
              else if (tatCa.indexOf(t) !== -1) hitTat++;
            });
            if (hitKho) d = 4 + hitKho * 3;
            else if (hitTat) d = 1 + hitTat;
          }
          if (d) ra.push([d, ten.length, n]);
        }
        ra.sort(function (a, b) { return b[0] - a[0] || a[1] - b[1]; });
        var kq = ra.slice(0, 12).map(function (x) { return x[2]; });
        kq.ganDung = ra.length > 0 && ra[0][0] < 30;   // không khớp hẳn, chỉ là ngành gần nhất
        return kq;
      }

      function datalistHtml(kind) {
        var list = SUGGEST[kind]; if (!list) return '';
        return '<datalist id="dl_' + kind + '">' + list.map(function (o) { return '<option value="' + esc(o) + '">'; }).join('') + '</datalist>';
      }

      /* ================= Ô nhập → chỗ in trên mẫu =================
         Một ô nhập có thể đổ vào nhiều chỗ in, hoặc tách ngày ra ba chỗ ngày/tháng/năm.
           to: ['w4']                 → ghi nguyên văn vào w4
           to: {w5:'d', w6:'m', w7:'y'} → tách ngày tháng năm
           to: {w8:'date'}            → ghi dạng 15/03/2026
           to: {w9:'=Nam'}            → đánh X vào w9 khi ô được chọn đúng giá trị "Nam"
           to: {w10:'x'}              → đánh X khi ô được tích                                   */
      function slotValue(val, how) {
        if (how === 'd' || how === 'm' || how === 'y' || how === 'y2') {
          // nhận cả ngày đầy đủ "2026-03-15" lẫn ô chọn tháng "2026-03"
          var p = String(val).split('-');
          if (p.length < 2) return '';
          if (how === 'd') return p.length === 3 ? p[2] : '';
          if (how === 'm') return p[1];
          return how === 'y2' ? p[0].slice(-2) : p[0];
        }
        if (how === 'date') return fmtDateSlash(val);
        if (how === 'words') return dateInWords(val);
        if (how === 'x') return val ? 'X' : '';
        if (how && how.charAt(0) === '=') return (val === how.slice(1)) ? 'X' : '';
        // "o:<giá trị>" — ô tích: khi được chọn thì trả đúng giá trị của ô đánh dấu để mẫu in ☑
        if (how && how.slice(0, 2) === 'o:') return val ? how.slice(2) : '';
        return val;
      }
      function expandToSlots(spec, v) {
        var out = {};
        (spec.form || []).forEach(function (f) {
          if (f.sec || !f.to) return;
          var val = v[f.key];
          if (val === undefined || val === null || String(val) === '') return;
          if (f.upper) val = String(val).toUpperCase();
          if (Array.isArray(f.to)) f.to.forEach(function (k) { out[k] = val; });
          else Object.keys(f.to).forEach(function (k) {
            var s = slotValue(val, f.to[k]);
            if (s !== '') out[k] = s;
          });
        });
        return out;
      }

      function docxSpecToForm(c, num) {
        var fields = [], lastSec = null;

        // mẫu đã được soạn tay: dùng danh sách ô nhập trong c.form, mỗi ô đổ vào chỗ in qua c.form[].to
        if (c.form) {
          c.form.forEach(function (f) {
            if (f.sec) { fields.push({ section: f.sec, secNote: f.note, secOptional: !!f.optional }); return; }
            var o = { key: f.key, label: f.label, type: f.type || 'text' };
            ['options', 'default', 'note', 'wide', 'placeholder', 'suggest', 'std', 'hint', 'maKey', 'copy'].forEach(function (k) { if (f[k] !== undefined) o[k] = f[k]; });
            fields.push(o);
          });
          return {
            id: c.id, num: num, group: c.group, title: c.title, custom: true, fullDoc: true, handmade: true,
            docTitle: c.title, fields: fields,
            body: function (v) { return docxRender(c.blocks || [], expandToSlots(c, v)); }
          };
        }

        // mẫu chưa soạn tay: giữ cách cũ, mỗi chỗ in là một ô nhập
        (c.fields || []).forEach(function (f) {
          if (f.section !== lastSec) { fields.push(SEC(f.section)); lastSec = f.section; }
          var o = { key: f.key, label: f.label, type: f.type || 'text' };
          if (f.options) o.options = f.options;
          if (f.default) o.default = f.default;
          if (f.std === 'office') o.stdOffice = true;
          if (f.std === 'place') o.stdPlace = true;
          if (f.std && f.std.indexOf('date-') === 0) o.stdDate = f.std.slice(5);
          fields.push(o);
        });
        return {
          id: c.id, num: num, group: c.group, title: c.title, custom: true, fullDoc: true, docTitle: c.title, fields: fields,
          body: function (v) { return docxRender(c.blocks || [], v); }
        };
      }

      /* ================= cấu hình mẫu từ host (quản trị) ================= */
