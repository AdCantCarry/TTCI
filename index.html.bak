            T('noiLap', 'Làm tại (địa danh)'),
            D('ngayLap', 'Ngày lập tờ khai', { default: 'today' }),
          ],
          signerMode: 'single',
          signerName: function (v) { return v.yc_hoTen; },
          body: function (v) {
            var out = '';
