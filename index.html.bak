          <div class="ofc-grid">
            <!-- 1. Điện thoại liên hệ -->
            <div class="ofc-box">
              <div class="ofc-box-icon phone">📞</div>
              <div>
                <div class="ofc-box-label">Điện thoại liên hệ & Hỗ trợ</div>
                <div style="margin-top:2px;">
                  <a href="tel:0965250877"
                    style="font-weight:700; color:#1D5FD8; text-decoration:none; font-size:14.5px;">096.5250.877 (Di
                    động)</a>
                </div>
                <div style="color:#556987; font-size:13px; margin-top:1px;">
                  <a href="tel:02866867477" style="color:#1D5FD8; text-decoration:none; font-weight:600;">028.6686.7477
                    (Điện thoại bàn)</a>
                </div>
