nh", "maKey": "maNganh", "hint": "Gõ vài chữ rồi bấm chọn trong danh sách — mã ngành tự điền. Nếu không có trong danh sách thì cứ gõ tay tên ngành và mã ngành.", "to": ["tenNganh"] }, { "key": "maNganh", "label": "Mã ngành", "placeholder": "VD: 4773", "to": ["maNganh"] }, { "key": "nganhChinh", "label": "Đây là ngành, nghề kinh doanh chính", "type": "check", "to": { "nganhChinh": "x" } }, { "key": "vonKinhDoanh", "label": "Vốn kinh doanh", "wide": true, "placeholder": "VD: 50.000.000 đồng (năm mươi triệu đồng)", "hint": "Ghi cả bằng số và bằng chữ theo yêu cầu của mẫu.", "to": ["w34"] }, { "sec": "Đăng ký thuế" }, { "key": "ngayBatDau", "label": "Ngày bắt đầu hoạt động", "type": "date", "hint": "Bỏ trống nếu bắt đầu ngay từ ngày được cấp Giấy chứng nhận.", "to": { "w42": "d", "w43": "m", "w44": "y" } }, { "key": "soLaoDong", "label": "Tổng số lao động (dự kiến)", "type": "number", "to": ["w45"] }, { "key": "ppThue", "label": "Phương pháp tính thuế GTGT", "type": "radio", "options": ["Phương pháp kê khai", "Phương pháp khoán"], "to": { "ppKeKhai": "=Phương pháp kê khai", "ppKhoan": "=Phương pháp khoán" } }, { "sec": "Địa chỉ nhận thông báo thuế", "optional": true, "note": "Thường trùng với trụ sở — bấm nút dưới đây là chép sang, khỏi gõ lại. Chỉ khai tay khi địa chỉ nhận thông báo thuế khác trụ sở." }, { "key": "chepTruSo", "type": "copy", "label": "Chép điện thoại, fax, email, website từ trụ sở", "hint": "Phần Xã/Phường và Tỉnh/Thành phố của trụ sở đã in sẵn trong mẫu nên không chép được — nếu địa chỉ thuế khác trụ sở thì gõ tay hai ô đó.", "copy": { "thueDienThoai": "tsDienThoai", "thueFax": "tsFax", "thueEmail": "tsEmail", "thueWebsite": "tsWebsite" } }, { "key": "thueXaPhuong", "label": "Xã/Phường", "suggest": "xaPhuong", "to": ["w35"] }, { "key": "thueTinhTP", "label": "Tỉnh/Thành phố", "suggest": "tinhTP", "to": ["w36"] }, { "key": "thueDienThoai", "label": "Điện thoại", "to": ["w37"] }, { "key": "thueFax", "label": "Fax (nếu có)", "to": ["w38"] }, { "key": "th