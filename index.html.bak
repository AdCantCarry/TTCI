    </section>

    <!-- SCREEN 2: nhập liệu -->
    <section class="screen" id="screen-form">
      <button class="backlink" data-back-to="select">&larr; Chọn lại loại giấy tờ</button>
      <div class="panel">
        <div class="panel-head">
          <div>
            <h2 id="formTitle"></h2>
            <div class="meta" id="formMeta"></div>
          </div>
        </div>
        <div class="voice-hint">🎙️ Bấm biểu tượng micro cạnh ô nhập để đọc thay vì gõ chữ — cần có mạng và cho phép
          quyền micro.</div>
        <div class="profile-bar" id="profileBar" hidden></div>
