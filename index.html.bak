        'khai-sinh': 'Khai sinh', 'ket-hon': 'Kết hôn', 'khai-tu': 'Khai tử', 'giam-ho': 'Giám hộ', 'cham-dut-giam-ho': 'Chấm dứt giám hộ', 'nhan-cha-me-con': 'Nhận cha, mẹ, con',
        'ghi-so-khai-sinh': 'Khai sinh', 'ghi-chu-ket-hon': 'Ghi chú kết hôn', 'ghi-chu-ly-hon': 'Ghi chú ly hôn', 'ghi-so-khai-tu': 'Khai tử', 'ghi-so-nuoi-con-nuoi': 'Nuôi con nuôi', 'ghi-so-giam-ho-nhan-cmc': 'Giám hộ, nhận cha, mẹ, con', 'ghi-so-khac': 'Việc hộ tịch khác',
        'dang-ky-lai-khai-sinh': 'Khai sinh', 'dang-ky-lai-ket-hon': 'Kết hôn', 'dang-ky-lai-khai-tu': 'Khai tử',
        'thay-doi-cai-chinh': 'Thay đổi, cải chính hộ tịch', 'ban-sao-trich-luc': 'Cấp bản sao trích lục', 'xac-nhan-ttthn': 'Xác nhận tình trạng hôn nhân', 'ban-cam-doan': 'Bản cam đoan'
      };
      function qDoc(c1, c2, id) {
        return '<defs><linearGradient id="' + id + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="' + c1 + '"/><stop offset="1" stop-color="' + c2 + '"/></linearGradient></defs>' +
          '<circle cx="40" cy="40" r="36" fill="rgba(255,255,255,.35)"/>' +
          '<rect x="17" y="10" width="40" height="52" rx="7" fill="url(#' + id + ')"/>' +
          '<rect x="25" y="21" width="24" height="4.5" rx="2.2" fill="#fff"/>' +
          '<rect x="25" y="31" width="24" height="4.5" rx="2.2" fill="#fff"/>' +
          '<rect x="25" y="41" width="16" height="4.5" rx="2.2" fill="#fff"/>';
      }
      function qPerson(col) {
        return '<circle cx="57" cy="56" r="15" fill="#fff"/><circle cx="57" cy="51" r="5.2" fill="' + col + '"/><path d="M47.5 65a9.5 8 0 0 1 19 0z" fill="' + col + '"/>';
      }
      var QUICK_ICONS = {
        'khai-sinh': '<svg width="84" height="84" viewBox="0 0 80 80">' + qDoc('#4C97FF', '#1656DB', 'qg0') + qPerson('#1D63D6') + '</svg>',
        'ket-hon': '<svg width="84" height="84" viewBox="0 0 80 80"><defs><linearGradient id="qg1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FF6A8A"/><stop offset="1" stop-color="#D81E4E"/></linearGradient></defs><circle cx="40" cy="40" r="36" fill="rgba(255,255,255,.35)"/><circle cx="29" cy="49" r="15" fill="none" stroke="url(#qg1)" stroke-width="7"/><circle cx="51" cy="49" r="15" fill="none" stroke="url(#qg1)" stroke-width="7"/><path d="M40 29C29 21 30 9 40 15C50 9 51 21 40 29z" fill="#F0305F"/></svg>',
        'khai-tu': '<svg width="84" height="84" viewBox="0 0 80 80">' + qDoc('#3FD993', '#0E9A5B', 'qg2') + '<g transform="rotate(38 56 44)"><rect x="51.5" y="18" width="10" height="40" rx="2.5" fill="#1F7AE0"/><rect x="51.5" y="18" width="10" height="7" rx="2" fill="#155BB5"/><path d="M51.5 58h10l-5 10z" fill="#F7CC8A"/><path d="M55 65h3l-1.5 3z" fill="#34465F"/></g></svg>',
        'xac-nhan-ttthn': '<svg width="84" height="84" viewBox="0 0 80 80">' + qDoc('#A68CFF', '#6841E3', 'qg3') + '<circle cx="57" cy="52" r="7" fill="#8D6CF5" stroke="#fff" stroke-width="2.5"/><path d="M44 70a13 11 0 0 1 26 0z" fill="#8D6CF5" stroke="#fff" stroke-width="2.5"/></svg>',
        'ban-sao-trich-luc': '<svg width="84" height="84" viewBox="0 0 80 80"><defs><linearGradient id="qg4" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFA640"/><stop offset="1" stop-color="#F0640C"/></linearGradient></defs><circle cx="40" cy="40" r="36" fill="rgba(255,255,255,.35)"/><rect x="27" y="8" width="38" height="50" rx="6" fill="#FFC56B"/><rect x="18" y="16" width="40" height="52" rx="7" fill="url(#qg4)"/><rect x="26" y="27" width="24" height="4.5" rx="2.2" fill="#fff"/><rect x="26" y="37" width="24" height="4.5" rx="2.2" fill="#fff"/><rect x="26" y="47" width="24" height="4.5" rx="2.2" fill="#fff"/><rect x="26" y="57" width="14" height="4.5" rx="2.2" fill="#fff"/></svg>',
        'thay-doi-cai-chinh': '<svg width="84" height="84" viewBox="0 0 80 80"><defs><linearGradient id="qg5" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3FA7FF"/><stop offset="1" stop-color="#1263DE"/></linearGradient></defs><circle cx="40" cy="40" r="36" fill="rgba(255,255,255,.35)"/><g transform="translate(9 9) scale(2.6)"><path fill="url(#qg5)" d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.830-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/><circle cx="12" cy="12" r="3.4" fill="#D6F1FF"/></g></svg>'
      };

      var CHEV_F = '<svg class="fchev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>';
      var CHEV_Q = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>';
      var ARROW_R = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg>';

      /* ================= MẢNG THỦ TỤC (lĩnh vực) =================
         Mỗi mảng là một thẻ ở màn hình đầu; bấm vào thì xổ danh sách thủ tục của mảng đó.
         Mảng Hộ tịch có nhiều nhóm con nên panel được chia theo groups[]. */
      var DOMAINS = [
        {
          id: 'ho-tich', cls: 'g0', bg: '#1D5FD8', name: 'Hộ tịch', full: 'Thủ tục hộ tịch',
          groups: ['Đăng ký lần đầu', 'Ghi vào Sổ hộ tịch (việc đã đăng ký ở nước ngoài)', 'Đăng ký lại', 'Thủ tục khác'],
          icon: '<svg width="62" height="62" viewBox="0 0 64 64"><path d="M14 6h26l12 12v36a4 4 0 0 1-4 4H14a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4z" fill="#fff"/><path d="M40 6v10a2 2 0 0 0 2 2h10z" fill="#CFE2FF"/><rect x="17" y="24" width="20" height="4" rx="2" fill="#1F66EC"/><rect x="17" y="33" width="24" height="4" rx="2" fill="#1F66EC"/><rect x="17" y="42" width="14" height="4" rx="2" fill="#1F66EC"/><g transform="rotate(40 46 42)"><rect x="42" y="22" width="9" height="28" rx="2" fill="#fff" stroke="#1F66EC" stroke-width="2.4"/><path d="M42 50h9l-4.5 8z" fill="#fff" stroke="#1F66EC" stroke-width="2.4" stroke-linejoin="round"/></g></svg>'
        },

        {
          id: 'chung-thuc', cls: 'g1', bg: '#11925A', name: 'Chứng thực', full: 'Chứng thực – Ủy quyền',
          groups: ['Chứng thực – Ủy quyền'],
          icon: '<svg width="62" height="62" viewBox="0 0 64 64"><path d="M12 6h26l12 12v34a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4z" fill="#fff"/><path d="M38 6v10a2 2 0 0 0 2 2h10z" fill="#BFEDE2"/><rect x="15" y="25" width="22" height="3.6" rx="1.8" fill="#0F8672"/><rect x="15" y="33" width="18" height="3.6" rx="1.8" fill="#0F8672"/><circle cx="44" cy="44" r="13" fill="#0F8672" stroke="#fff" stroke-width="3"/><path d="M38 44.5l4.2 4.2L50 41" stroke="#fff" stroke-width="3.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        },

        {
          id: 'dat-dai', cls: 'g3', bg: '#E6B04A', name: 'Đất đai', full: 'Thủ tục đất đai',
          groups: ['Đất đai'],
          icon: '<svg width="62" height="62" viewBox="0 0 64 64"><path d="M6 20l17-8 18 8 17-8v36l-17 8-18-8-17 8z" fill="#fff"/><path d="M23 12v36M41 20v36" stroke="#C98220" stroke-width="2.6" stroke-dasharray="5 4"/><circle cx="32" cy="30" r="8" fill="#F2B84A" stroke="#C98220" stroke-width="2.4"/><circle cx="32" cy="28.5" r="2.8" fill="#fff"/><path d="M32 38c-3-4-5-6.2-5-9a5 5 0 0 1 10 0c0 2.8-2 5-5 9z" fill="#C98220"/></svg>'
        },

        {
          id: 'xay-dung', cls: 'g5', bg: '#E06C0B', name: 'Xây dựng', full: 'Giấy phép xây dựng',
          groups: ['Xây dựng'],
          icon: '<svg width="62" height="62" viewBox="0 0 64 64"><path d="M8 30L32 11l24 19v26a3 3 0 0 1-3 3H11a3 3 0 0 1-3-3z" fill="#fff"/><path d="M4 31L32 9l28 22" stroke="#E06C0B" stroke-width="4.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><rect x="19" y="36" width="12" height="10" rx="1.6" fill="#F5872A"/><rect x="35" y="36" width="10" height="23" rx="1.6" fill="#F5872A"/><rect x="19" y="50" width="12" height="9" rx="1.6" fill="#FFC078"/></svg>'
        },

        {
          id: 'hkd', cls: 'g4', bg: '#6B3DD8', name: 'Hộ kinh doanh', full: 'Đăng ký hộ kinh doanh',
          groups: ['Hộ kinh doanh'],
          icon: '<svg width="62" height="62" viewBox="0 0 64 64"><path d="M10 26h44v28a3 3 0 0 1-3 3H13a3 3 0 0 1-3-3z" fill="#fff"/><path d="M8 14h48l4 12a7 7 0 0 1-14 0 7 7 0 0 1-14 0 7 7 0 0 1-14 0 7 7 0 0 1-14 0z" fill="#8A5CF0"/><rect x="24" y="36" width="16" height="21" rx="2" fill="#C3A6FF"/><rect x="43" y="36" width="8" height="8" rx="1.6" fill="#C3A6FF"/></svg>'
        },

        {
          id: 'btxh', cls: 'g2', bg: '#E8335F', name: 'Bảo trợ xã hội', full: 'Chính sách bảo trợ xã hội',
          groups: ['Bảo trợ xã hội'],
          icon: '<svg width="62" height="62" viewBox="0 0 64 64"><path d="M32 50C18 40 10 33 10 24.5A11.5 11.5 0 0 1 32 19a11.5 11.5 0 0 1 22 5.5C54 33 46 40 32 50z" fill="#fff"/><path d="M32 44C21 36 15 31 15 25a7.5 7.5 0 0 1 14.5-2.6L32 27l2.5-4.6A7.5 7.5 0 0 1 49 25c0 6-6 11-17 19z" fill="#F0717A"/><path d="M6 60c3.5-7 10-10.5 14-10.5h10c2.2 0 4-1.5 4-3.5" stroke="#fff" stroke-width="4" fill="none" stroke-linecap="round"/></svg>'
        },

        {
          id: 'attp', cls: 'g6', bg: '#2E9E37', name: 'An toàn thực phẩm', full: 'An toàn thực phẩm',
          groups: ['An toàn thực phẩm'],
          icon: '<svg width="62" height="62" viewBox="0 0 64 64"><circle cx="32" cy="32" r="22" fill="#fff"/><circle cx="32" cy="32" r="13" fill="#9CE98B"/><path d="M14 8v16a5 5 0 0 0 10 0V8M19 8v10" stroke="#2E9E37" stroke-width="3.4" fill="none" stroke-linecap="round"/><path d="M24 44l6 6 12-14" stroke="#2E9E37" stroke-width="4.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        }
      ];

      var DOMAIN_BY_ID = {}, GROUP_DOMAIN = {}, GROUP_ORDER = [];
      DOMAINS.forEach(function (d) {
        DOMAIN_BY_ID[d.id] = d;
        d.groups.forEach(function (g) { GROUP_DOMAIN[g] = d.id; if (GROUP_ORDER.indexOf(g) === -1) GROUP_ORDER.push(g); });
      });
      function domainOf(f) { return f.domain || GROUP_DOMAIN[f.group] || DOMAINS[0].id; }

      var GRP_HEAD_ICON = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M9 12h6M9 16h4" stroke-linecap="round"/></svg>';
      var CHEV_UP = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg>';
      var openGroup = -1;

      function setOpenGroup(gi) {
        openGroup = gi;
        document.querySelectorAll('.cat-card').forEach(function (c) { c.classList.toggle('open', +c.getAttribute('data-gi') === gi); c.setAttribute('aria-expanded', +c.getAttribute('data-gi') === gi); });
        document.querySelectorAll('.group-card').forEach(function (p) { p.classList.toggle('open', +p.getAttribute('data-gi') === gi); });
        document.querySelector('.sel').classList.toggle('has-open', gi >= 0);
        if (gi >= 0) {
          var panel = document.querySelector('.group-card[data-gi="' + gi + '"]');
          if (panel && panel.getBoundingClientRect().bottom > window.innerHeight) panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }

      function formCardHtml(f) {
        var d = DOMAIN_BY_ID[domainOf(f)] || {};
        var keys = (f.title + ' ' + (SHORT_TITLES[f.id] || '') + ' ' + (f.group || '') + ' ' + (d.name || '') + ' ' + (d.full || '')).toLowerCase();
        return '<button class="form-card" data-id="' + f.id + '" title="' + esc(f.title) + '" data-search="' + esc(keys) + '">' +
          '<span class="num">' + f.num + '</span><span class="ttl">' + esc(f.title) + '</span>' +
          CHEV_F.replace('width="16" height="16"', 'width="22" height="22"') + '</button>';
      }

      function renderCards() {
        var cHost = document.getElementById('quickGrid');
        var pHost = document.getElementById('cardGroups');
        var cards = '', panels = '';
        DOMAINS.forEach(function (d, gi) {
          var items = FORMS.filter(function (f) { return domainOf(f) === d.id; });
          if (!items.length) return;

          cards += '<button class="cat-card ' + d.cls + '" type="button" data-gi="' + gi + '" aria-expanded="false" title="' + esc(d.full || d.name) + '">' +
            '<span class="ci">' + d.icon + '</span>' +
            '<span class="cbody"><span><span class="ct">' + esc(d.name) + '</span>' +
            '<span class="cs"><span class="n">' + items.length + ' thủ tục</span><span class="o">Nhấn để xem chi tiết</span></span></span></span></button>';

          // thân panel: mảng nhiều nhóm con (Hộ tịch) thì chia theo nhóm, còn lại là danh sách phẳng
          var body = '';
          if (d.groups.length > 1) {
            d.groups.forEach(function (g) {
              var sub = items.filter(function (f) { return f.group === g; });
              if (!sub.length) return;
              var i = g.indexOf('(');
              var nm = i === -1 ? g : g.slice(0, i).trim();
              var note = i === -1 ? '' : '<small>(' + esc(g.slice(i + 1).replace(/\)$/, '')) + ')</small>';
              body += '<div class="grp-sub">' + esc(nm) + note + '</div>' + sub.map(formCardHtml).join('');
            });
          } else {
            body = items.map(formCardHtml).join('');
          }

          panels += '<div class="group-card" data-gi="' + gi + '" data-domain="' + d.id + '">' +
            '<div class="grp-head" title="Thu gọn"><span class="gicon" style="background:' + d.bg + '">' + GRP_HEAD_ICON + '</span>' +
            '<span class="gttl">Danh sách thủ tục – ' + esc(d.full || d.name) + '</span>' +
            '<span class="grp-count">' + items.length + ' thủ tục ' + CHEV_UP + '</span></div>' +
            '<div class="card-grid">' + body + '</div></div>';
        });
        cHost.innerHTML = cards;
        pHost.innerHTML = panels;

        cHost.querySelectorAll('.cat-card').forEach(function (c) {
          c.addEventListener('click', function () { var gi = +c.getAttribute('data-gi'); setOpenGroup(openGroup === gi ? -1 : gi); });
        });
        pHost.querySelectorAll('.grp-head').forEach(function (h) { h.addEventListener('click', function () { if (!document.querySelector('.sel').classList.contains('searching')) setOpenGroup(-1); }); });
        pHost.querySelectorAll('.form-card').forEach(function (btn) {
          btn.addEventListener('click', function () { selectForm(btn.getAttribute('data-id')); });
        });
      }

      function applySearch() {
        var q = document.getElementById('searchInput').value.trim().toLowerCase();
        var sel = document.querySelector('.sel');
        var noResults = document.getElementById('noResults');
        sel.classList.toggle('searching', !!q);
        if (!q) {
          noResults.hidden = true;
          document.querySelectorAll('.form-card, .group-card').forEach(function (c) { c.classList.remove('hidden'); });
          return;
        }
        var anyMatch = false;
        document.querySelectorAll('.group-card').forEach(function (g) {
          var n = 0;
          g.querySelectorAll('.form-card').forEach(function (c) {
            var match = c.getAttribute('data-search').indexOf(q) !== -1;
            c.classList.toggle('hidden', !match);
            if (match) { n++; anyMatch = true; }
          });
          g.classList.toggle('hidden', n === 0);
        });
        noResults.hidden = anyMatch;
      }

      /* ================= render: steps bar ================= */
      function renderSteps() {
        var bar = document.getElementById('stepsBar');
        var order = [['select', '1. Chọn loại giấy tờ'], ['form', '2. Nhập thông tin'], ['preview', '3. Xem lại & in']];
        bar.style.display = state.screen === 'admin' ? 'none' : '';
        var idx = order.findIndex(function (o) { return o[0] === state.screen; });
        bar.innerHTML = order.map(function (o, i) {
          var cls = 'step' + (i === idx ? ' active' : (i < idx ? ' done' : ''));
          return '<span class="' + cls + '">' + o[1] + '</span>' + (i < order.length - 1 ? '<span class="step-sep">›</span>' : '');
        }).join('');
      }

      /* ================= screen switching ================= */
      function showScreen(name) {
        stopActiveRecognition();
        state.screen = name;
        document.body.classList.toggle('on-select', name === 'select');
        if (name === 'select') {
          if (typeof fitSelect === 'function') setTimeout(fitSelect, 0);
          if (window._startHeroCanvas) window._startHeroCanvas();
        } else {
          if (window._stopHeroCanvas) window._stopHeroCanvas();
        }
        ['select', 'form', 'preview', 'admin'].forEach(function (s) {
          document.getElementById('screen-' + s).classList.toggle('active', s === name);
        });
        renderSteps();
        window.scrollTo({ top: 0, behavior: 'instant' in window ? 'instant' : 'auto' });
      }

      function selectForm(id) {
        var form = getForm(id);
        if (!form) return;
        state.formId = id;
        state.values = {};
        // defaults
        form.fields.forEach(function (f) {
          if (f.section) return;
          if (f.default === 'today') state.values[f.key] = todayIso();
          else if (f.default) state.values[f.key] = f.default;
          else if (f.stdOffice) state.values[f.key] = settings.office || '';
          else if (f.stdPlace) state.values[f.key] = settings.place || '';
          else if (f.stdDate) { var dd = new Date(); state.values[f.key] = String(f.stdDate === 'ngày' ? dd.getDate() : f.stdDate === 'tháng' ? dd.getMonth() + 1 : dd.getFullYear()); }
          else if (/^Quốc tịch/i.test(f.label) && (f.type === 'text' || !f.type)) state.values[f.key] = 'Việt Nam';   // đa số là Việt Nam, ai khác thì sửa/đọc lại
        });
        // thông tin người khai đã nhập ở tờ khai trước → tự điền sẵn
        form.fields.forEach(function (f) {
          if (f.section || !f.std) return;
          var p = profile[f.std];
          if (p !== undefined && String(p).trim() !== '') state.values[f.key] = p;
        });
        if (!state.values.noiLap && settings.place) state.values.noiLap = settings.place;
        if (settings.office) state.values.coQuan = settings.office;
        renderFormScreen();
        showScreen('form');
      }

      /* ================= render: data entry form ================= */
      function fieldHtml(f) {
        // Giấy tờ tùy thân: tách thành 2 ô — số giấy tờ và ngày cấp
        if (f.type === 'text' && /^Giấy tờ tùy thân$/i.test(f.label) && !f._split) {
          return fieldHtml({ key: f.key, label: 'Số giấy tờ tùy thân', note: f.note, type: 'text', _split: true, placeholder: 'Số CCCD (12 số) hoặc số hộ chiếu' }) +
            fieldHtml({ key: f.key + '_ngayCap', label: 'Ngày cấp', type: 'date', _split: true });
        }
        var id = 'f_' + f.key;
        var val = state.values[f.key] || '';
        var wideClass = f.wide ? ' wide' : '';
        var noteHtml = f.note ? ' <span class="note">(' + f.note + ')</span>' : '';
        var inner = '';
        var micHtml = '<button type="button" class="micbtn" data-mic-target="' + id + '" title="Nhập bằng giọng nói" aria-label="Nhập bằng giọng nói">' + MIC_ICON + '</button>';
        if (f.type === 'textarea') {
          inner = '<div class="inputmic"><textarea id="' + id + '" data-key="' + f.key + '" placeholder="' + esc(f.placeholder || '') + '">' + esc(val) + '</textarea>' + micHtml + '</div>';
        } else if (f.type === 'date') {
          inner = '<input type="date" id="' + id + '" data-key="' + f.key + '" value="' + esc(val) + '">';
        } else if (f.type === 'month') {
          inner = '<input type="month" id="' + id + '" data-key="' + f.key + '" value="' + esc(val) + '">';
        } else if (f.type === 'number') {
          inner = '<input type="number" min="0" id="' + id + '" data-key="' + f.key + '" value="' + esc(val) + '">';
        } else if (f.type === 'radio') {
          inner = '<div class="radiorow">' + f.options.map(function (o, i) {
            var checked = (val === o) ? ' checked' : '';
            return '<label><input type="radio" name="' + f.key + '" value="' + esc(o) + '" data-key="' + f.key + '"' + checked + '> ' + esc(o) + '</label>';
          }).join('') + '</div>';
        } else if (f.type === 'select') {
          inner = '<select id="' + id + '" data-key="' + f.key + '">' +
            '<option value=""' + (val ? '' : ' selected') + '>— Chọn —</option>' +
            f.options.map(function (o) { return '<option value="' + esc(o) + '"' + (val === o ? ' selected' : '') + '>' + esc(o) + '</option>'; }).join('') +
            '</select>';
        } else if (f.type === 'check') {
          return '<div class="field wide checkfield"><label class="checkline"><input type="checkbox" id="' + id + '" data-key="' + f.key + '"' + (val ? ' checked' : '') + '> <span>' + esc(f.label) + '</span></label>' +
            (f.hint ? '<div class="fhint">' + esc(f.hint) + '</div>' : '') + '</div>';
        } else if (f.type === 'copy') {
          // nút chép nguyên thông tin từ mục khác sang, đỡ phải gõ lại
          return '<div class="field wide"><button type="button" class="copybtn" data-copy="' + esc(JSON.stringify(f.copy)) + '">' +
            '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> ' +
            esc(f.label) + '</button>' + (f.hint ? '<div class="fhint">' + esc(f.hint) + '</div>' : '') + '</div>';
        } else if (f.type === 'nganh') {
          // ô tra ngành, nghề: gõ vài chữ để lọc, bấm một dòng là điền cả tên ngành lẫn mã ngành
          return '<div class="field wide nganhfield"><label for="' + id + '">' + esc(f.label) + noteHtml + '</label>' +
            '<div class="nganhbox"><div class="inputmic">' +
            '<input type="text" id="' + id + '" data-key="' + f.key + '" data-nganh="' + esc(f.maKey || '') + '" autocomplete="off" ' +
            'placeholder="' + esc(f.placeholder || 'Gõ vài chữ để tìm, VD: tạp hóa, quán ăn, cắt tóc…') + '" value="' + esc(val) + '">' +
            micHtml + '</div><div class="nganhlist" hidden></div></div>' +
            (f.hint ? '<div class="fhint">' + esc(f.hint) + '</div>' : '') + '</div>';
        } else {
          var listAttr = (f.suggest && SUGGEST[f.suggest]) ? ' list="dl_' + f.suggest + '"' : '';
          inner = '<div class="inputmic"><input type="text" id="' + id + '" data-key="' + f.key + '"' + listAttr + ' placeholder="' + esc(f.placeholder || '') + '" value="' + esc(val) + '">' + micHtml + '</div>';
        }
        var hintHtml = f.hint ? '<div class="fhint">' + esc(f.hint) + '</div>' : '';
        var stdMark = (f.std && PROFILE_LABEL[f.std]) ? ' <span class="stdtag" title="Thông tin này dùng chung cho mọi tờ khai trong phiên làm việc">dùng chung</span>' : '';
        return '<div class="field' + wideClass + '"><label for="' + id + '">' + esc(f.label) + noteHtml + stdMark + '</label>' + inner + hintHtml + '</div>';
      }

      function renderFormScreen() {
        var form = getForm(state.formId);
        document.getElementById('formTitle').textContent = form.title;
        var dmn = DOMAIN_BY_ID[domainOf(form)];
        document.getElementById('formMeta').textContent = form.fullDoc
          ? ((dmn ? dmn.full + ' — ' : '') + 'mẫu ' + form.num + ', giữ nguyên bố cục bản gốc')
          : 'Mẫu ' + form.num + ' — Thông tư số 04/2020/TT-BTP';
        var host = document.getElementById('dataForm');
        var html = '';
        var currentSectionFields = [];
        var sectionTitle = null, sectionNote = null, sectionOptional = false, secIdx = 0;
        function flush() {
          if (sectionTitle === null && currentSectionFields.length === 0) return;
          secIdx++;
          // mọi mục đều mở sẵn để người dân không khai sót; mục tùy chọn có nút thu lại cho đỡ dài
          var cls = sectionOptional ? ' class="fs-opt"' : '';
          var toggle = sectionOptional ? '<span class="fs-toggle">Thu lại</span>' : '';
          var note = sectionNote ? '<div class="fs-note">' + esc(sectionNote) + '</div>' : '';
          html += '<fieldset' + cls + ' data-sec="' + secIdx + '"><div class="fs-legend">' + esc(sectionTitle || 'Thông tin') + toggle + '</div>' +
            '<div class="fs-inner">' + note + '<div class="field-grid">' + currentSectionFields.join('') + '</div></div></fieldset>';
          currentSectionFields = [];
          sectionNote = null; sectionOptional = false;
        }
        if (!form.fullDoc) {
          currentSectionFields.push(fieldHtml({ key: 'coQuan', label: 'Kính gửi (cơ quan tiếp nhận)', type: 'text', wide: true, placeholder: 'VD: Ủy ban nhân dân phường Đông Hưng Thuận' }));
          sectionTitle = 'Cơ quan tiếp nhận';
          flush();
          sectionTitle = null;
        }
        form.fields.forEach(function (f) {
          if (f.section) {
            flush();
            sectionTitle = f.section;
            sectionNote = f.secNote || null;
            sectionOptional = !!f.secOptional;
            return;
          }
          currentSectionFields.push(fieldHtml(f));
        });
        flush();
        host.innerHTML = html + Object.keys(SUGGEST).map(datalistHtml).join('');
        // nút chép thông tin từ mục khác
        host.querySelectorAll('.copybtn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var map = JSON.parse(btn.getAttribute('data-copy')), n = 0;
            Object.keys(map).forEach(function (dich) {
              var v = state.values[map[dich]];
              if (v !== undefined && String(v).trim() !== '') { state.values[dich] = v; n++; }
            });
            renderFormScreen();
            showToast(n ? 'Đã chép ' + n + ' thông tin sang mục này.' : 'Mục nguồn chưa có thông tin nào để chép.');
          });
        });

        // ô tra ngành, nghề kinh doanh
        host.querySelectorAll('[data-nganh]').forEach(function (inp) {
          var box = inp.closest('.nganhbox'), list = box.querySelector('.nganhlist');
          var maKey = inp.getAttribute('data-nganh');
          function ve() {
            var ds = timNganh(inp.value);
            if (!ds.length) {
              list.innerHTML = '<div class="nganh-none">Không tìm thấy ngành nào. Thử từ khác ngắn hơn — ví dụ <b>cho thuê</b>, <b>bán lẻ</b>, <b>sửa chữa</b>, <b>dịch vụ</b> — hoặc tự gõ thẳng tên ngành vào ô trên.</div>';
              list.hidden = false; return;
            }
            list.innerHTML = (ds.ganDung ? '<div class="nganh-near">Không có ngành trùng hẳn. Đây là những ngành gần nhất:</div>' : '') +
              ds.map(function (n) {
                return '<button type="button" class="nganh-item" data-ma="' + esc(n[0]) + '" data-ten="' + esc(n[1]) + '">' +
                  '<span class="nganh-ma">' + esc(n[0]) + '</span><span class="nganh-ten">' + esc(n[1]) + '</span></button>';
              }).join('');
            list.hidden = false;
            list.querySelectorAll('.nganh-item').forEach(function (it) {
              it.addEventListener('mousedown', function (e) {
                e.preventDefault();
                state.values[inp.getAttribute('data-key')] = it.getAttribute('data-ten');
                if (maKey) state.values[maKey] = it.getAttribute('data-ma');
                renderFormScreen();
              });
            });
          }
          inp.addEventListener('focus', ve);
          inp.addEventListener('input', ve);
          inp.addEventListener('blur', function () { setTimeout(function () { list.hidden = true; }, 120); });
        });

        host.querySelectorAll('fieldset.fs-opt .fs-legend').forEach(function (lg) {
          lg.addEventListener('click', function () {
            var fs = lg.parentNode;
            fs.classList.toggle('collapsed');
            lg.querySelector('.fs-toggle').textContent = fs.classList.contains('collapsed') ? 'Mở ra' : 'Thu lại';
          });
        });
        refreshProfileBar();

        // bind events
        host.querySelectorAll('[data-key]').forEach(function (el) {
          var evt = (el.type === 'radio' || el.type === 'checkbox') ? 'change' : 'input';
          el.addEventListener(evt, function () {
            var k = el.getAttribute('data-key');
            if (el.type === 'radio') {
              if (!el.checked) return;
              state.values[k] = el.value;
            } else if (el.type === 'checkbox') {
              state.values[k] = el.checked ? 'X' : '';
            } else {
              state.values[k] = el.value;
            }
            // ghi lại thông tin người khai & gợi ý địa chỉ cho những tờ khai sau
            var fd = fieldByKey(k);
            if (fd && fd.std && PROFILE_LABEL[fd.std]) { profile[fd.std] = state.values[k]; saveProfile(); refreshProfileBar(); }
            if (fd && fd.suggest) rememberSuggest(fd.suggest, state.values[k]);
            updateCounter();
          });
        });
        updateCounter();
        setupVoiceInputs(host);
      }

      function fieldByKey(k) {
        var form = getForm(state.formId); if (!form) return null;
        for (var i = 0; i < form.fields.length; i++) { if (form.fields[i].key === k) return form.fields[i]; }
        return null;
      }
      function refreshProfileBar() {
        var bar = document.getElementById('profileBar'); if (!bar) return;
        var n = profileCount();
        if (!n) { bar.hidden = true; bar.innerHTML = ''; return; }
        var who = [];
        if (profile.hoTen) who.push(profile.hoTen);
        if (profile.cccd) who.push('CCCD ' + profile.cccd);
        bar.hidden = false;
        bar.innerHTML = '<span class="pb-ic">✓</span>' +
          '<span class="pb-tx">Đang dùng thông tin người khai' +
          (who.length ? ': <b>' + esc(who.join(' — ')) + '</b>' : ' (đã lưu ' + n + ' mục)') +
          '. Các tờ khai sau tự điền sẵn; đóng trình duyệt là xoá hết.</span>' +
          '<button type="button" class="pb-clear" id="pbClear">Xoá, khai người mới</button>';
        document.getElementById('pbClear').addEventListener('click', function () {
          clearProfile();
          selectForm(state.formId);
        });
      }

      function updateCounter() {
        var form = getForm(state.formId);
        var total = form.fields.filter(function (f) { return !f.section; }).length;
        var filled = 0;
        form.fields.forEach(function (f) {
          if (f.section) return;
          var v = state.values[f.key];
          if (v && String(v).trim()) filled++;
        });
        document.getElementById('fieldCounter').textContent = filled + ' / ' + total + ' trường đã nhập';
      }

      /* ================= render: preview / document ================= */
      function renderPreview() {
        var form = getForm(state.formId);
        var v = Object.assign({}, state.values);
        // ghép "Giấy tờ tùy thân" từ 2 ô: số + ngày cấp
        form.fields.forEach(function (f) {
          if (f.type !== 'text' || !/^Giấy tờ tùy thân$/i.test(f.label)) return;
          var so = String(v[f.key] || '').trim(), ngay = v[f.key + '_ngayCap'];
          if (!so && !ngay) return;
          var txt = so ? (/^\d[\d\s]*$/.test(so) ? 'CCCD số ' + so.replace(/\s+/g, '') : so) : 'CCCD số …';
          if (ngay) txt += ', cấp ngày ' + fmtDateSlash(ngay);
          v[f.key] = txt;
        });
        document.getElementById('previewTitle').textContent = form.title;
        if (form.fullDoc) { document.getElementById('docOutput').innerHTML = '<div class="wdoc">' + form.body(v) + '</div>'; return; }

        var html = '';
        html += '<div class="doc-head"><div class="quochieu">Cộng hòa xã hội chủ nghĩa Việt Nam</div>' +
          '<div class="tieungu">Độc lập – Tự do – Hạnh phúc</div></div>';
        html += '<div class="doc-title">' + esc(form.docTitle) + '</div>';
        html += '<div class="doc-sub">' + (form.subTitle ? esc(form.subTitle) : '(Theo Thông tư số 04/2020/TT-BTP ngày 28/5/2020 của Bộ Tư pháp)') + '</div>';

        var office = v.coQuan || settings.office || '';
        html += '<div class="kinhgui">Kính gửi: ' + bl(office, 220) + '</div>';

        html += '<div class="doc-body">' + form.body(v) + '</div>';

        html += '<div class="camdoan">' + (form.camDoanText || 'Tôi cam đoan những nội dung khai trên đây là đúng sự thật và chịu trách nhiệm trước pháp luật về cam đoan của mình.') + '</div>';
        if (form.afterCamDoan) html += form.afterCamDoan(v);
        html += madeAtLine(v);

        // signature block(s) — printed blank, signed by hand on paper after printing
        if (form.signerMode === 'double') {
          var names = form.signerNames(v);
          var labels = form.signerLabels || ['Bên A', 'Bên B'];
          html += '<div class="siggrid">' +
            sigBoxHtml(labels[0], names[0]) +
            sigBoxHtml(labels[1], names[1]) +
            '</div>';
        } else {
          var name = form.signerName ? form.signerName(v) : '';
          var label = form.signerLabelOverride || 'Người yêu cầu';
          html += '<div class="siggrid single">' + sigBoxHtml(label, name) + '</div>';
        }

        html += '<div class="footnote">Tờ khai được lập điện tử dựa trên mẫu tại Phụ lục 5 kèm theo Thông tư số 04/2020/TT-BTP ngày 28/5/2020 của Bộ Tư pháp. Vui lòng kiểm tra kỹ thông tin trước khi in.</div>';

        document.getElementById('docOutput').innerHTML = html;
      }

      function sigBoxHtml(who, typedName) {
        return '<div class="sigbox">' +
          '<div class="who">' + esc(who) + '</div>' +
          '<div class="instr">(Ký, ghi rõ họ, chữ đệm, tên)</div>' +
          '<div class="sigline"></div>' +
          '<div class="signame">' + esc(typedName || '') + '</div>' +
          '</div>';
      }

      /* ================= events ================= */
      document.getElementById('toPreviewBtn').addEventListener('click', function () {
        renderPreview();
        showScreen('preview');
      });
      document.querySelectorAll('[data-back-to]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var to = btn.getAttribute('data-back-to');
          showScreen(to);
        });
      });
      document.getElementById('printBtn').addEventListener('click', function () {
        var btn = this;
        btn.disabled = true;
        var orig = btn.innerHTML;
        btn.innerHTML = 'Đang mở hộp thoại in…';
        setTimeout(function () {
          window.print();
          setTimeout(function () {
            btn.disabled = false;
            btn.innerHTML = orig;
          }, 400);
        }, 40);
      });
      document.getElementById('newFormBtn').addEventListener('click', function () {
        state.formId = null; state.values = {};
        document.getElementById('searchInput').value = '';
        applySearch();
        setOpenGroup(-1);
        showScreen('select');
      });

      /* search on the select screen */
      document.getElementById('searchInput').addEventListener('input', applySearch);
      document.getElementById('searchGoBtn').addEventListener('click', function (e) {
        e.preventDefault();
        applySearch();
        document.getElementById('searchInput').focus();
      });

      /* settings modal */
      document.getElementById('settingsBtn2').addEventListener('click', function () { document.getElementById('settingsBtn').click(); });
      document.getElementById('settingsBtn').addEventListener('click', function () {
        document.getElementById('setOffice').value = settings.office || '';
        document.getElementById('setPlace').value = settings.place || '';
        document.getElementById('settingsModal').classList.add('show');
      });
      document.getElementById('settingsCancel').addEventListener('click', function () {
        document.getElementById('settingsModal').classList.remove('show');
      });
      document.getElementById('settingsModal').addEventListener('click', function (e) {
        if (e.target === this) this.classList.remove('show');
      });
      document.getElementById('settingsSave').addEventListener('click', function () {
        settings.office = document.getElementById('setOffice').value.trim();
        settings.place = document.getElementById('setPlace').value.trim();
        saveSettings();
        refreshOfficeLabel();
        document.getElementById('settingsModal').classList.remove('show');
      });

      /* ================= đọc file Word (.docx) thành mẫu tờ khai ================= */
      function unzipEntry(buf, name) {
        var u8 = new Uint8Array(buf), dv = new DataView(buf);
        var eocd = -1;
        for (var i = u8.length - 22; i >= Math.max(0, u8.length - 65557); i--) { if (dv.getUint32(i, true) === 0x06054b50) { eocd = i; break; } }
        if (eocd < 0) return Promise.reject(new Error('Không phải file .docx hợp lệ.'));
        var n = dv.getUint16(eocd + 10, true), off = dv.getUint32(eocd + 16, true);
        var dec = new TextDecoder('utf-8');
        for (var k = 0; k < n; k++) {
          if (dv.getUint32(off, true) !== 0x02014b50) break;
          var method = dv.getUint16(off + 10, true), csize = dv.getUint32(off + 20, true);
          var nlen = dv.getUint16(off + 28, true), elen = dv.getUint16(off + 30, true), clen = dv.getUint16(off + 32, true);
          var lho = dv.getUint32(off + 42, true);
          var fname = dec.decode(u8.subarray(off + 46, off + 46 + nlen));
          if (fname === name) {
            var start = lho + 30 + dv.getUint16(lho + 26, true) + dv.getUint16(lho + 28, true);
            var data = u8.subarray(start, start + csize);
            if (method === 0) return Promise.resolve(dec.decode(data));
            if (method !== 8) return Promise.reject(new Error('File nén theo kiểu chưa hỗ trợ.'));
            if (typeof DecompressionStream === 'undefined') return Promise.reject(new Error('Trình duyệt quá cũ, hãy dùng Chrome/Edge/Cốc Cốc mới.'));
            var ds = new Blob([data]).stream().pipeThrough(new DecompressionStream('deflate-raw'));
            return new Response(ds).text();
          }
          off += 46 + nlen + elen + clen;
        }
        return Promise.reject(new Error('Không tìm thấy nội dung trong file Word.'));
      }

      var BLANK_RE = /[.…_](?: ?[.…_])+|…+/g;
      var BOX_RE = /[☐□☑■◻❑]/;
      /* những dòng không bao giờ được dùng làm tên mục: quốc hiệu, dòng kẻ, ghi chú mẫu, số thứ tự trơ */
      var BAD_SECTION = /^(CỘNG H[ÒO]A|Độc lập|Hạnh phúc|-{3,}|_{3,}|Phụ lục|Mẫu s[ốô]|\(|\d+\s*[-–.)]?\s*$)|\(Ký/i;
      function docxParse(xml) {
        var doc = new DOMParser().parseFromString(xml, 'application/xml');
        var W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
        function kids(el, tag) { var out = []; for (var c = el.firstElementChild; c; c = c.nextElementSibling) { if (c.localName === tag) out.push(c); } return out; }
        function first(el, tag) { return el ? el.getElementsByTagNameNS(W, tag)[0] : null; }
        function on(el) { if (!el) return false; var v = el.getAttributeNS(W, 'val'); return v === null || v === '' || (v !== 'false' && v !== '0' && v !== 'none'); }
        function paraSegs(p) {
          var segs = [];
          var ppr = first(p, 'pPr'); var jc = ppr ? kids(ppr, 'jc')[0] : null;
          var al = jc ? jc.getAttributeNS(W, 'val') : '';
          var pBold = false;
          function walk(el) {
            for (var c = el.firstElementChild; c; c = c.nextElementSibling) {
              var ln = c.localName;
              if (ln === 'r') {
                var rpr = kids(c, 'rPr')[0];
                var st = {
                  b: rpr ? on(kids(rpr, 'b')[0]) : false, i: rpr ? on(kids(rpr, 'i')[0]) : false, u: rpr ? !!kids(rpr, 'u')[0] && on(kids(rpr, 'u')[0]) : false,
                  sup: rpr && kids(rpr, 'vertAlign')[0] ? kids(rpr, 'vertAlign')[0].getAttributeNS(W, 'val') === 'superscript' : false
                };
                for (var t = c.firstElementChild; t; t = t.nextElementSibling) {
                  if (t.localName === 't') segs.push(Object.assign({ s: t.textContent }, st));
                  else if (t.localName === 'tab') segs.push(Object.assign({ s: '    ' }, st));
                  else if (t.localName === 'br') segs.push({ s: '\n' });
                  else if (t.localName === 'sym') { var ch = (t.getAttributeNS(W, 'char') || '').toUpperCase(); segs.push(Object.assign({ s: /F0A8|F06F|F071|F0FE|F078/.test(ch) ? '☐' : '' }, st)); }
                }
              } else if (ln === 'hyperlink' || ln === 'ins' || ln === 'smartTag' || ln === 'sdt' || ln === 'sdtContent' || ln === 'fldSimple') { walk(c); }
            }
          }
          walk(p);
          return { al: al === 'both' ? 'justify' : (al === 'end' ? 'right' : al), segs: segs };
        }
        var blocks = [];
        var body = first(doc.documentElement, 'body');
        if (!body) throw new Error('File Word không có nội dung.');
        function readBody(el, into) {
          for (var c = el.firstElementChild; c; c = c.nextElementSibling) {
            if (c.localName === 'p') into.push({ p: paraSegs(c) });
            else if (c.localName === 'tbl') {
              var rows = kids(c, 'tr').map(function (tr) { return kids(tr, 'tc').map(function (tc) { var cb = []; readBody(tc, cb); return cb; }); });
              into.push({ tb: rows });
            } else if (c.localName === 'sdt') { var sc = kids(c, 'sdtContent')[0]; if (sc) readBody(sc, into); }
          }
        }
        readBody(body, blocks);
        return blocks;
      }
      function plainText(segs) { return segs.map(function (s) { return s.s; }).join(''); }
      function sliceSegs(segs, a, b) {
        var out = [], pos = 0;
        segs.forEach(function (s) {
          var e = pos + s.s.length, x = Math.max(a, pos), y = Math.min(b, e);
          if (y > x) out.push(Object.assign({}, s, { s: s.s.slice(x - pos, y - pos) }));
          pos = e;
        });
        return out;
      }
      function cleanLabel(t) {
        t = t.replace(/\s+/g, ' ').replace(/[\s:;,\-–]+$/, '').replace(/\s*\(\s*\d+\s*\)\s*$/, '').replace(/[\s:;,\-–]+$/, '').trim();
        t = t.replace(/^[,;.\s]+/, '');
        if (t.length > 70) { var cut = Math.max(t.lastIndexOf('. '), t.lastIndexOf('; '), t.lastIndexOf(': ')); if (cut > 0) t = t.slice(cut + 2); if (t.length > 70) t = '…' + t.slice(-68); }
        return t;
      }
      /* từ các khối văn bản → danh sách ô nhập + khối có đánh dấu ô */
      function docxToForm(blocks) {
        var fields = [], used = {}, n = 0, ctx = '', ctxCount = {};
        var todayParts = (function () { var d = new Date(); return { 'ngày': String(d.getDate()), 'tháng': String(d.getMonth() + 1), 'năm': String(d.getFullYear()) }; })();
        var title = '';
        function addField(label, extra) {
          n++; var key = 'w' + n;
          var base = label || ctx || 'Nội dung', lab = base, id = (ctx || '') + '|' + base;
          if (used[id]) { used[id]++; lab = base + ' (' + used[id] + ')'; } else used[id] = 1;
          var f = Object.assign({ key: key, label: lab, type: 'text', section: ctx || 'Thông tin' }, extra || {});
          if (/^kính gửi/i.test(base)) f.std = 'office';
          else if (/^(làm tại|nơi lập)/i.test(base)) f.std = 'place';
          else if (/^dân tộc$/i.test(base)) f.default = 'Kinh';
          fields.push(f);
          return f;
        }
        function doPara(p, nextIsBlankLine) {
          var txt = plainText(p.segs);
          var trimmed = txt.replace(/\s+/g, ' ').trim();
          var hasBlank = BLANK_RE.test(txt); BLANK_RE.lastIndex = 0;
          var hasBox = BOX_RE.test(txt);
          // nhiều mẫu chừa chỗ điền bằng tab sau dấu hai chấm thay vì dấu chấm:
          // "Mã số hộ kinh doanh: <tab>" — chỉ nhận khi dòng kế tiếp không phải dòng chấm chấm
          if (!hasBlank && !hasBox && /:[  ]{2,}$/.test(txt) && !nextIsBlankLine && trimmed.length <= 90) {
            var labC = cleanLabel(trimmed);
            if (labC) {
              var fC = addField(labC);
              return { al: p.al, runs: p.segs.concat([{ f: fC.key, w: 40 }]) };
            }
          }
          if (!hasBlank && !hasBox) {
            if (trimmed && !title && /^TỜ KHAI|^BẢN CAM ĐOAN|^ĐƠN |^GIẤY /i.test(trimmed) && trimmed === trimmed.toUpperCase()) title = trimmed;
            var isBold = p.segs.length && p.segs.every(function (x) { return x.b || !x.s.trim(); });
            if (trimmed && (isBold || /:$/.test(trimmed) || trimmed.length <= 40) && trimmed.length <= 90 && !BAD_SECTION.test(trimmed) && /[a-zA-ZÀ-ỹ]{3}/.test(trimmed)) ctx = trimmed.replace(/:$/, '');
            return { al: p.al, runs: p.segs };
          }
          var runs = [], last = 0, m;
          var isMadeAt = /làm tại|ngày\s*[.…_]/i.test(txt);
          // ô trống dạng chấm/gạch
          var marks = [];
          BLANK_RE.lastIndex = 0;
          while ((m = BLANK_RE.exec(txt))) {
            // dãy 2 ký tự chỉ tính là chỗ điền khi đứng ngay sau dấu hai chấm ("Mã số doanh nghiệp:..")
            if (m[0].replace(/\s/g, '').length < 3 && m[0].indexOf('…') === -1 && !/:[ \t]*$/.test(txt.slice(0, m.index))) continue;
            marks.push({ a: m.index, b: m.index + m[0].length, kind: 'blank', w: m[0].length });
          }
          // ô đánh dấu ☐: gom trong cùng đoạn thành 1 ô chọn
          var boxRe = /([^\s,;:☐□☑■◻❑(][^,;:☐□☑■◻❑]{0,24}?)\s*[☐□☑■◻❑]/g, boxes = [];
          while ((m = boxRe.exec(txt))) { boxes.push({ a: m.index + m[0].length - 1, b: m.index + m[0].length, opt: m[1].trim() }); }
          var boxField = null;
          if (boxes.length) {
            var pre = txt.slice(0, boxes[0].a - boxes[0].opt.length - 1);
            var lastBlankBefore = marks.filter(function (x) { return x.b <= boxes[0].a; }).pop();
            if (lastBlankBefore) pre = txt.slice(lastBlankBefore.b, boxes[0].a - boxes[0].opt.length - 1);
            boxField = addField(cleanLabel(pre) || 'Lựa chọn', { type: 'radio', options: boxes.map(function (x) { return x.opt; }) });
            boxes.forEach(function (x) { marks.push({ a: x.a, b: x.b, kind: 'box', opt: x.opt }); });
          }
          marks.sort(function (x, y) { return x.a - y.a; });
          var prevEnd = 0;
          marks.forEach(function (mk) {
            if (mk.a < last) return;
            runs = runs.concat(sliceSegs(p.segs, last, mk.a));
            if (mk.kind === 'box') { runs.push({ cb: boxField.key, o: mk.opt }); }
            else {
              var lab = cleanLabel(txt.slice(prevEnd, mk.a));
              var f;
              var dp = lab.toLowerCase().replace(/^.*[\s,]/, '');
              if (isMadeAt && todayParts[dp] && lab.length <= 12) f = addField(dp.charAt(0).toUpperCase() + dp.slice(1) + ' lập tờ khai', { std: 'date-' + dp, small: true });
              else f = addField(lab);
              runs.push({ f: f.key, w: Math.min(mk.w, 60) });
            }
            last = mk.b; prevEnd = mk.b;
          });
          runs = runs.concat(sliceSegs(p.segs, last, txt.length));
          return { al: p.al, runs: runs };
        }
        function walk(list) {
          return list.map(function (b, i) {
            if (b.p) {
              var nx = list[i + 1];
              var nextBlank = false;
              if (nx && nx.p) { nextBlank = BLANK_RE.test(plainText(nx.p.segs)); BLANK_RE.lastIndex = 0; }
              return { p: doPara(b.p, nextBlank) };
            }
            return { tb: b.tb.map(function (row) { return row.map(function (cell) { return walk(cell); }); }) };
          });
        }
        var out = walk(blocks);
        return { blocks: out, fields: fields, title: title };
      }
      /* hiển thị bản in từ khối Word */
      function docxRender(blocks, v) {
        function runsHtml(runs) {
          return runs.map(function (r) {
            if (r.f) { var val = v[r.f]; return (val !== undefined && String(val).trim() !== '') ? ' <span class="filled">' + esc(val) + '</span> ' : '<span class="blank" style="min-width:' + Math.max(24, (r.w || 10) * 4) + 'px"></span>'; }
            if (r.cb) { return v[r.cb] === r.o ? '<b>☑</b>' : '☐'; }
            var t = esc(r.s || '').replace(/\n/g, '<br>').replace(/ {2,}/g, function (m) { return m.replace(/ /g, '&nbsp;'); });
            if (r.sup) t = '<sup>' + t + '</sup>';
            if (r.u) t = '<u>' + t + '</u>';
            if (r.i) t = '<i>' + t + '</i>';
            if (r.b) t = '<b>' + t + '</b>';
            return t;
          }).join('');
        }
        function blk(list) {
          return list.map(function (b) {
            if (b.p) { var h = runsHtml(b.p.runs); return '<div class="wp"' + (b.p.al ? ' style="text-align:' + esc(b.p.al) + '"' : '') + '>' + (h || '&nbsp;') + '</div>'; }
            return '<table class="wtb"><tbody>' + b.tb.map(function (row) { return '<tr>' + row.map(function (cell) { return '<td>' + blk(cell) + '</td>'; }).join('') + '</tr>'; }).join('') + '</tbody></table>';
          }).join('');
        }
        return blk(blocks).replace(/<\/span> ([,.;:)])/g, '</span>$1');
      }
      /* ================= Hồ sơ người khai dùng chung =================
         Điền một lần, mọi tờ khai ở mọi mảng tự điền sẵn.
         CHỈ nhớ trong phiên làm việc: đóng trình duyệt là xoá sạch (sessionStorage). */
      var PROFILE_LABEL = {
        hoTen: 'Họ và tên', ngaySinh: 'Ngày sinh', gioiTinh: 'Giới tính', danToc: 'Dân tộc', quocTich: 'Quốc tịch',
        cccd: 'Số CCCD/định danh', cccdNgayCap: 'Ngày cấp CCCD', cccdNoiCap: 'Nơi cấp CCCD',
        noiThuongTru: 'Nơi thường trú', xaPhuong: 'Xã/Phường', tinhTP: 'Tỉnh/Thành phố',
        dienThoai: 'Điện thoại', email: 'Thư điện tử',
        tenHKD: 'Tên hộ kinh doanh', maSoHKD: 'Mã số hộ kinh doanh', noiLapTK: 'Địa danh làm tờ khai'
      };
      var profile = {};
      try { var _pr = sessionStorage.getItem('tk_profile'); if (_pr) profile = JSON.parse(_pr) || {}; } catch (e) { }
      function saveProfile() { try { sessionStorage.setItem('tk_profile', JSON.stringify(profile)); } catch (e) { } }
      function clearProfile() { profile = {}; try { sessionStorage.removeItem('tk_profile'); } catch (e) { } }
      function profileCount() { var n = 0; for (var k in profile) { if (profile[k] && String(profile[k]).trim()) n++; } return n; }

      /* ================= Gợi ý địa chỉ trên địa bàn =================
