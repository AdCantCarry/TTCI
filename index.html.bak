            T('cha_namSinh', 'Năm sinh', { note: '4' }),
            T('cha_danToc', 'Dân tộc', { default: 'Kinh' }),
            T('cha_quocTich', 'Quốc tịch'),
            T('cha_noiCuTru', 'Nơi cư trú', { note: '2' }),
            SEC('Đăng ký tại nước ngoài'),
            T('daDangKyTai', 'Đã được đăng ký khai sinh tại', { note: '5' }),
